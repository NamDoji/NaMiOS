    "gold":           { "hex": "#DEA93E", "rgb": [222, 169, 62], "role": "signature accent: selection/focus/highlight; primary action trên nền TỐI" },
    "vermilion":      { "hex": "#D64C3E", "rgb": [214, 76, 62],  "role": "action/attention/destructive — nền nút/icon/chữ LỚN (KHÔNG chữ thường nhỏ)" },
    "teal":           { "hex": "#278F8D", "rgb": [39, 143, 141], "role": "secondary/support accent; link/icon cỡ vừa" },
    "ivory":          { "hex": "#FFF9EF", "rgb": [255, 249, 239],"role": "nền sáng/nội dung; chữ trên nền tối" },
    "white":          { "hex": "#FFFFFF", "rgb": [255, 255, 255],"role": "surface nổi (card/dialog) ở light mode" },
    "vermilion-deep": { "hex": "#A02E22", "rgb": [160, 46, 34],  "derived_from": "vermilion (L 54%->38%)", "role": "chữ đỏ (lỗi/nhấn) trên nền SÁNG" },
    "vermilion-light":{ "hex": "#E48A81", "rgb": [228, 138, 129],"derived_from": "vermilion (L 54%->70%)", "role": "chữ đỏ (lỗi) trên nền TỐI" },
    "gold-deep":      { "hex": "#8B6518", "rgb": [139, 101, 24], "derived_from": "gold (L 56%->32%)", "role": "chữ vàng / focus-ring trên nền SÁNG" },
    "teal-deep":      { "hex": "#1F706F", "rgb": [31, 112, 111], "derived_from": "teal (L 36%->28%)", "role": "link/chữ teal trên nền SÁNG (>=4.5:1)" },
    "teal-light":     { "hex": "#5FD3D1", "rgb": [95, 211, 209], "derived_from": "teal (L 36%->60%)", "role": "link/chữ teal trên nền TỐI (>=4.5:1)" },
    "navy-subtle":    { "hex": "#0A3257", "rgb": [10, 50, 87],   "derived_from": "navy (L 17%->19%)", "role": "nền hàng-chẵn/panel tầng giữa trên nền TỐI" },
    "navy-card":      { "hex": "#0B3965", "rgb": [11, 57, 101],  "derived_from": "navy (L 17%->22%)", "role": "card/surface-raised trên nền TỐI" },
    "ivory-subtle":   { "hex": "#FFF2DB", "rgb": [255, 242, 219],"derived_from": "ivory (L 97%->93%)", "role": "chip/ô nền tầng giữa trên nền SÁNG" }
  },

