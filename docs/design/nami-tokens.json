{
  "$meta": {
    "title": "NaMi Design Tokens — v3 \"Đông Sơn\" semantic layer (HIG §5.1–5.2)",
    "version": "1.0.0",
    "date": "2026-11-11",
    "owners": ["Đỗ Chí Cường", "Đỗ Bảo Nam"],
    "spec": "docs/design/hig/NaMi-Human-Interface-2026.md §5, §9",
    "doc": "docs/design/NAMI-DESIGN-TOKENS.md",
    "scope": "Lớp SEMANTIC token (nghĩa sử dụng) suy ra từ 6 mã AUTHORITATIVE PALETTE v3 Đông Sơn trong usr/share/namios-branding/logo/brand.json + sắc độ phụ trợ đã đo WCAG trong usr/share/namios/docs/BRAND.md. Đây là P1 (nền tảng) của HIG — TÀI LIỆU/TOKEN, CHƯA nối vào mọi app/shell (đó là P2–P4 + boot-test).",
    "authoritative_palette_source": "usr/share/namios-branding/logo/brand.json (navy #092D4F, gold #DEA93E, vermilion #D64C3E, teal #278F8D, ivory #FFF9EF, white #FFFFFF). brand.json là nguồn DUY NHẤT cho màu NHẬN DIỆN; màu TRẠNG THÁI (success/warning) là lớp token chức năng, không thuộc brand.json.",
    "relation_to_existing": "KHÁC với branding/design-system/tokens.json (bộ 'Sen Việt' teal/ivory 09/11) và design/tokens.json (PL12 ruby, lỗi thời). Bộ này bám palette v3 Đông Sơn đang CHẠY trong .colors/desktoptheme/brand.json. Lần hợp nhất kế tiếp nên gộp 3 nguồn về 1 (xem NAMI-DESIGN-TOKENS.md §7).",
    "contrast_method": "WCAG 2.x relative luminance: sRGB linearize (c<=0.03928 ? c/12.92 : ((c+0.055)/1.055)^2.4), L = 0.2126R+0.7152G+0.0722B, ratio = (Lhi+0.05)/(Llo+0.05). Tính bằng script /tmp/contrast.py, KHÔNG ước lượng bằng mắt. Mục tiêu: chữ thường >=4.5:1, chữ lớn/UI/icon/viền-mang-nghĩa/focus >=3:1; high-contrast nhắm >=7:1 cho chữ.",
    "unit": "dp = kích thước logic ở 100% scale; renderer Qt/Kirigami/CSS chịu trách nhiệm HiDPI + text-scale.",
    "verified_on_host": "NO — mọi tỷ lệ đo bằng công thức WCAG offline; hiển thị thật chỉ xác nhận khi boot KDE Plasma (boot-screenshot)."
  },

  "palette": {
