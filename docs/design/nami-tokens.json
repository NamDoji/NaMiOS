  "space":   { "unit": "dp", "scale": [4, 8, 12, 16, 24, 32], "panel_padding": 16, "rhythm": 8, "rule": "chỉ dùng giá trị trong thang; không khoảng cách tùy tiện (HIG §5.2)" },
  "radius":  { "unit": "dp", "sm": 8, "md": 12, "lg": 16, "pill": 999, "use": { "sm": "chip/nút nhỏ", "md": "button/input/select", "lg": "card/panel/dialog" }, "rule": "không bo mọi khối giống nhau (HIG §5.2)" },

  "typography": {
    "font_family": {
      "ui": "Noto Sans",
      "fallback": ["DejaVu Sans", "Liberation Sans", "sans-serif"],
      "mono": ["Noto Sans Mono", "DejaVu Sans Mono", "monospace"],
      "note": "Noto Sans + DejaVu phủ đủ dấu tiếng Việt, cấp phép phân phối trong OS (SIL OFL / Bitstream Vera). KHÔNG dùng font Microsoft. Gói thực tế: fonts-noto-core, fonts-noto-ui-core, fonts-noto-mono, fonts-dejavu-core, fonts-liberation2."
    },
    "scale_dp": {
      "hero":    { "size": 32, "line_height": 40, "weight": 600 },
      "h1":      { "size": 28, "line_height": 36, "weight": 600 },
      "h2":      { "size": 22, "line_height": 30, "weight": 600 },
      "h3":      { "size": 18, "line_height": 26, "weight": 600 },
      "body":    { "size": 16, "line_height": 24, "weight": 400 },
      "body-sm": { "size": 15, "line_height": 22, "weight": 400 },
      "label":   { "size": 14, "line_height": 20, "weight": 500 },
      "caption": { "size": 12, "line_height": 18, "weight": 400, "note": "chỉ chú thích phụ; KHÔNG dùng cho lỗi cần hành động (HIG §5.2)" },
      "code":    { "size": 14, "line_height": 20, "weight": 400, "family": "mono" }
    },
    "line_height_range": "1.4–1.6",
    "heading_levels_max": 4,
    "zoom_rule": "reflow tới 200% không cắt chữ/nút (WCAG 2.2 SC 1.4.4); test 100/125/150/200%",
    "case_rule": "KHÔNG viết HOA toàn câu thông báo"
  },

  "control": {
    "unit": "dp",
    "desktop_target_min": 32,
    "touch_target_min": 44,
    "height": { "compact": 36, "default": 40, "large": 44 },
    "rule": "vùng bấm desktop >=32x32, cảm ứng >=44x44 (HIG §5.2); nút nguy hiểm cách xa nút an toàn"
  },

  "icon": { "unit": "dp", "sm": 16, "default": 24, "lg": 32, "stroke": 1.9, "note": "symbolic currentColor; biến thể giản lược ở 16px; brand mark đầy đủ chỉ >=48px (HIG §5.1/5.3)" },

  "elevation": {
    "shadow": {
      "sm": "0 1px 2px rgba(9,45,79,0.10)",
      "md": "0 4px 12px rgba(9,45,79,0.12)",
      "lg": "0 12px 32px rgba(9,45,79,0.18)"
    },
    "note": "bóng mềm 1 lớp; dùng kèm border khi border-subtle không đạt 3:1"
  },

  "focus": {
    "ring_width_dp": 2,
    "ring_width_high_contrast_dp": 3,
    "ring_offset_dp": 2,
    "rule": "focus ring luôn thấy khi dùng bàn phím; KHÔNG chỉ đổi màu nền (HIG §9)"
  },

  "motion": {
    "duration_ms": { "fast": 120, "base": 180, "slow": 240 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "purpose": "diễn tả chuyển trạng thái/cửa sổ, không trang trí (HIG §5.2: 120–240ms)",
    "reduced_motion": { "flag": true, "rule": "prefers-reduced-motion: reduce -> tắt animation + blur tức thì, không cần khởi động lại" },
    "reduce_transparency": "có chế độ tắt blur khi ảnh hưởng đọc chữ/hiệu năng (máy yếu/không GPU — mặc định compositing TẮT)"
  },

  "breakpoints": {
    "min_supported": "1024x600 (theo khả năng nền tảng) / 1366x768 thực dụng",
    "test_matrix": ["1024x600", "1366x768", "1920x1080", "2560x1440"],
    "scaling_test": ["100%", "125%", "150%", "200%"],
    "rule": "sidebar không chiếm hết vùng nội dung ở 1366x768; dialog 400–560dp (HIG §12.2)"
  }
}
