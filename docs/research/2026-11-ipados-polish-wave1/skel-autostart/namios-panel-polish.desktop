[Desktop Entry]
Type=Application
Name=NaMiOS canh giữa panel nổi
Exec=/usr/local/bin/namios-panel-polish.sh
X-KDE-autostart-phase=2
NoDisplay=true

# ĐỀ XUẤT — nếu ghép: .sh ở usr/local/bin/namios-panel-polish.sh, .desktop
# này ở etc/skel/.config/autostart/namios-panel-polish.desktop. Phase=2
# (cùng phase với namios-widgets, sau khi panel/containment đã dựng xong,
# cần plasmashell đã sẵn sàng nhận evaluateScript).
#
# verified_on_host: NO — xem ghi chú trong namios-panel-polish.sh.
