#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""namipdf-inspect — CLI của PDF Compatibility/Safety Inspector (NaMiPDF).

Kiểm tra TĨNH một hoặc nhiều tệp PDF — KHÔNG render, KHÔNG thực thi
JavaScript/action, KHÔNG gọi mạng, KHÔNG cố vượt mật khẩu nếu không được
cung cấp — và in báo cáo document class ("Text PDF / Scan image / Mixed /
Signed / Protected") + tính năng rủi ro theo mức C0–C3 + severity.

Xem thiết kế đầy đủ + giới hạn trung thực ở:
  tools/pdf-compat/namipdf_inspect/__init__.py
  docs/specs/namipdf-v18/03_KIEN_TRUC_BAO_MAT.md
  docs/specs/namipdf-v18/01_TINH_NANG_UIUX.md §3
  docs/specs/namipdf-v18/05_PROMPT_CLAUDE_CODE.md

Cách dùng:
  tools/pdf-compat/namipdf-inspect TEP1.pdf [TEP2.pdf ...]
  tools/pdf-compat/namipdf-inspect --json TEP.pdf > report.json
  tools/pdf-compat/namipdf-inspect --password "matkhau" protected.pdf

Mã thoát = mức SEVERITY cao nhất trong số các tệp đã kiểm (tệp nào tệ nhất
quyết định mã thoát của cả lần chạy):
  0 = info/low (an toàn, không có cảnh báo đáng kể)
  1 = medium (cần xử lý riêng — OCR/kiểm appearance/... trước khi sửa)
  2 = high (chữ ký số/mã hoá đọc được/JavaScript/XFA/Launch mức thấp hơn...)
  3 = critical (yêu cầu mật khẩu không có/sai, hoặc action /Launch — chặn)
"""
from __future__ import annotations

import argparse
import json
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

from namipdf_inspect.inspector import (  # noqa: E402
    SEVERITY_EXIT_CODE,
    Severity,
    inspect_file,
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="namipdf-inspect",
        description=(
            "PDF Compatibility/Safety Inspector — kiểm tra TĨNH tệp PDF, phân loại document "
            "class (Text PDF/Scan image/Mixed/Signed/Protected) và nhận diện tính năng rủi ro "
            "(mã hoá, chữ ký số, JavaScript/action tự động, tệp đính kèm, XFA, AcroForm, liên "
            "kết ngoài, gợi ý PDF/A) TRƯỚC khi cho phép sửa. KHÔNG render, KHÔNG thực thi nội "
            "dung tệp, KHÔNG gọi mạng, KHÔNG cố vượt mật khẩu/quyền."
        ),
    )
    parser.add_argument("paths", nargs="+", help="Đường dẫn tới một hoặc nhiều tệp .pdf")
    parser.add_argument("--json", action="store_true",
                        help="In báo cáo dạng JSON (máy đọc) thay cho văn bản tiếng Việt.")
    parser.add_argument("--password", default=None,
                        help="Mật khẩu do người dùng chủ động cung cấp (KHÔNG phải bẻ khoá) để "
                             "phân tích sâu hơn một tệp được bảo vệ mà họ có quyền mở.")
    args = parser.parse_args(argv)

    reports = [inspect_file(p, password=args.password) for p in args.paths]

    if args.json:
        payload = [r.to_dict() for r in reports]
        print(json.dumps(payload if len(payload) != 1 else payload[0], ensure_ascii=False, indent=2))
    else:
        for i, r in enumerate(reports):
            if i > 0:
                print()
                print("-" * 70)
                print()
            print(r.to_text_vi())

    worst = Severity.INFO
    for r in reports:
        if SEVERITY_EXIT_CODE[r.max_severity] > SEVERITY_EXIT_CODE[worst]:
            worst = r.max_severity
    return SEVERITY_EXIT_CODE[worst]


if __name__ == "__main__":
    raise SystemExit(main())
