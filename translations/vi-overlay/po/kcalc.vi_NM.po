msgstr "Chế độ máy tính đơn giản"

msgid "A very simple mode where only the basic calculator buttons are shown"
msgstr "Chế độ rất đơn giản, chỉ hiện các nút máy tính cơ bản"

msgid "Science Calculator Mode"
msgstr "Chế độ máy tính khoa học"

