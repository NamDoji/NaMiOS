msgid "Could not write the file type definition %1: %2"
msgstr "Không ghi được định nghĩa kiểu tệp %1: %2"

msgctxt "@info %1 is a file name extension"
msgid "Could not update the file type database with the extension \"%1\"."
msgstr "Không cập nhật được cơ sở dữ liệu kiểu tệp với phần mở rộng “%1”."

msgctxt "@info %2 is a path"
msgid ""
"The security of the KIO worker for protocol ’%1’, which typically asks for "
"elevated permissions, can not be guaranteed because users other than root "
"have permission to modify it at %2."
msgstr ""
"Không thể bảo đảm an toàn cho trình xử lí KIO của giao thức ’%1’ (vốn thường"
" yêu cầu quyền nâng cao), vì những người dùng khác ngoài root có quyền sửa "
"đổi nó tại %2."

msgctxt "@info %2 and %3 are paths"
msgid ""
"The KIO worker for protocol “%1” in %2 was not loaded because all KIO "
"workers which are located outside of %3 and ask for elevated privileges are "
"considered insecure."
msgstr ""
"Trình xử lí KIO của giao thức “%1” trong %2 không được nạp, vì mọi trình xử "
"lí KIO nằm ngoài %3 mà yêu cầu quyền nâng cao đều bị coi là không an toàn."

