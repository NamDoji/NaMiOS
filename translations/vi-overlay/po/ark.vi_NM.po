msgstr "Không tìm thấy chương trình <filename>%1</filename> trên đĩa."

#, kde-format
msgid "Extraction failed. Make sure that enough space is available."
msgstr "Giải nén thất bại. Hãy chắc chắn còn đủ dung lượng trống."

#, kde-format
msgid ""
"Extraction failed. Make sure you provided the correct password and that "
"enough space is available."
msgstr ""
"Giải nén thất bại. Hãy chắc chắn bạn đã nhập đúng mật khẩu và còn đủ dung "
"lượng trống."

#, kde-format
msgctxt "@info"
msgid "Could not move the extracted file to the destination directory."
msgid_plural ""
"Could not move the extracted files to the destination directory."
msgstr[0] "Không di chuyển được các tệp đã giải nén tới thư mục đích."

#, kde-format
msgctxt "@info"
msgid "Extraction failed because the disk is full."
msgstr "Giải nén thất bại vì đĩa đã đầy."

#, kde-format
msgctxt "@info"
msgid "Extraction failed: Incorrect password"
msgstr "Giải nén thất bại: Mật khẩu không đúng"

#, kde-format
msgid "Incorrect password."
msgstr "Mật khẩu không đúng."

#, kde-format
