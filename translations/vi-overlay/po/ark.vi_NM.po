msgstr "Không thể bảo vệ danh sách tệp với định dạng %1."

#, kde-format
msgid ""
"Protection of the archive with password is not possible with the %1 format."
msgstr "Không thể bảo vệ kho bằng mật khẩu với định dạng %1."

#, kde-format
msgid "It is not possible to set compression level for the %1 format."
msgstr "Không thể đặt mức nén cho định dạng %1."

#, kde-format
msgid "It is not possible to set compression method for the %1 format."
msgstr "Không thể đặt phương pháp nén cho định dạng %1."

#, kde-format
msgid "The %1 format does not support multi-volume archives."
msgstr "Định dạng %1 không hỗ trợ kho nhiều phần."

