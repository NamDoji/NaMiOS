msgid "Archive"
msgstr "Kho lưu trữ"

#, kde-format
msgid ""
"Whether to show a warning when creating zip archives with AES encryption."
msgstr "Có hiện cảnh báo khi tạo kho zip với mã hoá AES hay không."

