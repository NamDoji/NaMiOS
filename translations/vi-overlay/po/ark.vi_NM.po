#, kde-format
msgctxt "Noun, not a verb. Top level menu item, i.e. like File"
msgid "&Archive"
msgstr "&Kho lưu trữ"

#, kde-format
msgid "Extracting Files"
msgstr "Đang giải nén tệp"

#, kde-format
msgid "Source archive"
msgstr "Kho nguồn"

#, kde-format
msgid "Destination"
msgstr "Đích"

#, kde-format
msgid "The following files could not be extracted:"
msgstr "Không giải nén được các tệp sau:"

#, kde-kuit-format
msgctxt "@info"
msgid ""
"There was an error while extracting <filename>%1</filename>. Any further "
"archive will not be extracted."
msgstr ""
"Đã có lỗi khi giải nén <filename>%1</filename>. Các kho tiếp theo sẽ không "
"được giải nén."

#, kde-kuit-format
msgctxt "@info"
msgid ""
"There was an error while extracting "
"<filename>%1</filename>:<nl/><message>%2</message><nl/>Any further archive "
"will not be extracted."
msgstr ""
"Đã có lỗi khi giải nén "
"<filename>%1</filename>:<nl/><message>%2</message><nl/>Các kho tiếp theo sẽ "
"không được giải nén."

#, kde-kuit-format
msgctxt "@info"
msgid "There was an error while extracting <filename>%1</filename>."
msgstr "Đã có lỗi khi giải nén <filename>%1</filename>."

#, kde-kuit-format
msgctxt "@info"
msgid ""
"There was an error while extracting "
"<filename>%1</filename>:<nl/><message>%2</message>"
msgstr ""
"Đã có lỗi khi giải nén <filename>%1</filename>:<nl/><message>%2</message>"

#, kde-kuit-format
msgctxt "@info"
msgid ""
"The archive could not be extracted to <filename>%1</filename> because Ark "
"can only extract to local destinations."
msgstr ""
"Không giải nén được kho vào <filename>%1</filename> vì Ark chỉ giải nén được"
" tới các đích cục bộ."

#, kde-format
msgctxt "@action:inmenu Compress submenu in Dolphin context menu"
msgid "Compress"
msgstr "Nén"

#, kde-format
msgctxt "@action:inmenu Part of Compress submenu in Dolphin context menu"
msgid "Compress to..."
msgstr "Nén thành..."

#, kde-format
msgctxt ""
"@action:inmenu Part of Compress submenu in Dolphin context menu, %1 filename"
msgid "Compress to \"%1\""
msgstr "Nén thành \"%1\""

#, kde-format
msgctxt "@action:inmenu Part of Extract submenu in Dolphin context menu"
msgid "Extract to…"
msgstr "Giải nén tới…"

#, kde-format
msgctxt "@action:inmenu Part of Extract submenu in Dolphin context menu"
msgid "Extract here"
msgstr "Giải nén vào đây"

#, kde-format
msgctxt "@action:inmenu Part of Extract submenu in Dolphin context menu"
msgid "Extract here and delete archive"
msgstr "Giải nén vào đây rồi xoá kho"

#, kde-format
msgctxt "@action:inmenu Extract submenu in Dolphin context menu"
msgid "Extract"
msgstr "Giải nén"

#, kde-format
msgctxt ""
"@action:inmenu Context menu shown when an archive is being drag'n'dropped"
msgid "Extract here"
msgstr "Giải nén vào đây"

#, kde-format
msgid "KDE Archiving tool"
msgstr "Công cụ nén/giải nén của KDE"

#, kde-format
msgid "Maintainer"
msgstr "Người bảo trì"

#, kde-format
msgid "Maintainer, KF5 port"
msgstr "Người bảo trì, chuyển sang KF5"

#, kde-format
msgid "Former Maintainer"
msgstr "Người bảo trì trước đây"

#, kde-format
msgid "Former maintainer"
msgstr "Người bảo trì trước đây"

#, kde-format
msgid "Advanced editing functionalities"
msgstr "Các tính năng chỉnh sửa nâng cao"

#, kde-format
msgid "Icons"
msgstr "Biểu tượng"

#, kde-format
msgid "Ideas, help with the icons"
msgstr "Ý tưởng, hỗ trợ biểu tượng"

#, kde-format
msgid "bkisofs code"
msgstr "Mã bkisofs"

#, kde-format
msgid "URLs to open."
msgstr "Các URL cần mở."

#, kde-format
msgid ""
"Show a dialog for specifying the options for the operation (extract/add)"
msgstr "Hiện hộp thoại để chỉ định các tùy chọn cho thao tác (giải nén/thêm)"

#, kde-format
msgid ""
"Destination folder to extract to. Defaults to current path if not specified."
msgstr ""
"Thư mục đích để giải nén. Mặc định là đường dẫn hiện tại nếu không chỉ định."

#, kde-format
msgid "Open destination folder after extraction."
msgstr "Mở thư mục đích sau khi giải nén."

#, kde-format
msgid ""
"Query the user for an archive filename and add specified files to it. Quit "
"when finished."
msgstr ""
"Hỏi người dùng tên tệp kho rồi thêm các tệp đã chỉ định vào đó. Thoát khi "
"hoàn tất."

#, kde-format
msgid ""
"Add the specified files to 'filename'. Create archive if it does not exist. "
"Quit when finished."
msgstr ""
"Thêm các tệp đã chỉ định vào 'filename'. Tạo kho nếu chưa có. Thoát khi hoàn"
" tất."

#, kde-format
msgid ""
"Change the current dir to the first entry and add all other entries relative"
" to this one."
msgstr ""
"Đổi thư mục hiện tại sang mục đầu tiên rồi thêm mọi mục khác tương đối theo "
"mục này."

#, kde-format
msgid ""
"Automatically choose a filename, with the selected suffix (for example rar, "
"tar.gz, zip or any other supported types)"
msgstr ""
"Tự động chọn tên tệp, với đuôi đã chọn (ví dụ rar, tar.gz, zip hoặc bất kỳ "
"loại nào khác được hỗ trợ)"

#, kde-format
msgid ""
"Use the batch interface instead of the usual dialog. This option is implied "
"if more than one url is specified."
msgstr ""
"Dùng giao diện hàng loạt thay cho hộp thoại thông thường. Tùy chọn này được "
"ngầm định nếu chỉ định nhiều hơn một url."

#, kde-format
msgid ""
"The destination argument will be set to the path of the first file supplied."
msgstr ""
"Tham số đích sẽ được đặt thành đường dẫn của tệp đầu tiên được cung cấp."

#, kde-format
msgid ""
"Archive contents will be read, and if detected to not be a single folder or "
"a single file archive, a subfolder with the name of the archive will be "
"created."
msgstr ""
"Nội dung kho sẽ được đọc, và nếu phát hiện không phải là kho một thư mục hay"
" một tệp duy nhất, một thư mục con mang tên kho sẽ được tạo."

#, kde-format
msgid "List supported MIME types."
msgstr "Liệt kê các loại MIME được hỗ trợ."

#, kde-format
msgid "Unable to find Ark's KPart component, please check your installation."
msgstr ""
"Không tìm thấy thành phần KPart của Ark, hãy kiểm tra bản cài đặt của bạn."

#, kde-format
msgid "Sidebar"
msgstr "Thanh bên"

#, kde-format
msgid "Welcome Page"
msgstr "Trang chào mừng"

#, kde-format
msgid "Show the welcome page"
msgstr "Hiện trang chào mừng"

#, kde-kuit-format
msgctxt "@info:whatsthis"
msgid ""
"This switches between having a <emphasis>Menubar</emphasis> and having a "
"<interface>Hamburger Menu</interface> button. Both contain mostly the same "
"commands and configuration options."
msgstr ""
"Mục này chuyển đổi giữa việc có <emphasis>Thanh trình đơn</emphasis> và có "
"nút <interface>Trình đơn Hamburger</interface>. Cả hai đều chứa gần như cùng"
" các lệnh và tùy chọn cấu hình."

