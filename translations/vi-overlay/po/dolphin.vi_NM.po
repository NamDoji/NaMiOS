# NaMiOS vi_NM overlay for Dolphin file manager (domain dolphin).
# Fills untranslated + rescues fuzzy strings (menus, toolbar, views, search, settings,
# panels, dialogs, status bar). Source: KDE l10n-vi stable6/messages/dolphin/dolphin.po.
msgid ""
msgstr ""
"Project-Id-Version: dolphin vi_NM overlay (NaMiOS)\n"
"Report-Msgid-Bugs-To: https://github.com/NamDoji/NaMiOS\n"
"PO-Revision-Date: 2026-11-06 00:00+0700\n"
"Last-Translator: NaMiOS vi_NM overlay\n"
"Language-Team: Vietnamese (vi_NM NaMiOS overlay)\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Overlay-Mo: dolphin.mo\n"

msgctxt "@info label above the view explaining the state"
msgid "Acting as an Administrator — Be careful!"
msgstr "Đang hành động với tư cách Quản trị viên — Hãy cẩn thận!"

msgctxt "@info label above the view explaining the state, keep short"
msgid "Acting as Admin"
msgstr "Đang là Quản trị"

msgctxt "@action:button Finish/Stop/Done acting as an admin"
msgid "Finish"
msgstr "Xong"

msgctxt "@info:tooltip"
msgid "Finish acting as an administrator"
msgstr "Kết thúc hành động với tư cách quản trị viên"

msgctxt "@action:button shown after acting as admin ended"
msgid "Act as Administrator Again"
msgstr "Hành động với tư cách Quản trị viên lần nữa"

msgctxt "@info"
msgid "Administrator authorization has expired."
msgstr "Uỷ quyền quản trị viên đã hết hạn."

msgctxt "@action:inmenu"
msgid "Act as Administrator"
msgstr "Hành động với tư cách Quản trị viên"

msgctxt "@info:shell"
msgid ""
"<application>Dolphin</application> requires <application>%1</application> to"
" manage system-controlled files, but it is not installed.<nl/>Press %2 to "
"install <application>%1</application> or %3 to cancel."
msgstr ""
"<application>Dolphin</application> cần <application>%1</application> để quản"
" lí các tệp do hệ thống kiểm soát, nhưng nó chưa được cài.<nl/>Ấn %2 để cài "
"<application>%1</application> hoặc %3 để huỷ."

msgctxt "tag-format-pattern <numberedlist> rich"
msgid "<ol>%1</ol>"
msgstr "<ol>%1</ol>"

msgctxt "tag-format-pattern <numbereditem> rich"
msgid "<li>%1</li>"
msgstr "<li>%1</li>"

msgctxt "@info"
msgid ""
"<para>Make use of your administrator rights in "
"Dolphin:<numberedlist><numbereditem>Navigate to the file or folder you want "
"to change.</numbereditem><numbereditem>Activate the \"%1\" action either "
"under <interface>Open Menu|More|View</interface> or <interface>Menu "
"Bar|View</interface>.<nl/>Default shortcut: "
"<shortcut>%2</shortcut></numbereditem><numbereditem>After authorization you "
"can manage files as an administrator.</numbereditem></numberedlist></para>"
msgstr ""
"<para>Tận dụng quyền quản trị viên của bạn trong "
"Dolphin:<numberedlist><numbereditem>Điều hướng tới tệp hoặc thư mục bạn muốn"
" thay đổi.</numbereditem><numbereditem>Kích hoạt hành động \"%1\" ở "
"<interface>Mở trình đơn|Thêm|Xem</interface> hoặc <interface>Thanh trình "
"đơn|Xem</interface>.<nl/>Phím tắt mặc định: "
"<shortcut>%2</shortcut></numbereditem><numbereditem>Sau khi được uỷ quyền, "
"bạn có thể quản lí tệp với tư cách quản trị "
"viên.</numbereditem></numberedlist></para>"

msgctxt "@title:window"
msgid "How to Administrate"
msgstr "Cách quản trị"

msgctxt "@info"
msgid ""
"<para>You are about to use administrator privileges. While acting as an "
"administrator you can change or replace any file or folder on this system. "
"This includes items which are critical for this system to "
"function.</para><para>You are able to <emphasis>delete every users' "
"data</emphasis> on this computer and to <emphasis>break this installation "
"beyond repair.</emphasis> Adding just one letter in a folder or file name or"
" its contents can render a system "
"<emphasis>unbootable.</emphasis></para><para>There is probably not going to "
"be another warning even if you are about to break this "
"system.</para><para>You might want to <emphasis>backup files and "
"folders</emphasis> before proceeding.</para>"
msgstr ""
"<para>Bạn sắp sử dụng quyền quản trị viên. Khi hành động với tư cách quản "
"trị viên, bạn có thể thay đổi hoặc thay thế bất kì tệp hay thư mục nào trên "
"hệ thống này. Điều này bao gồm cả những thứ thiết yếu cho hệ thống hoạt "
"động.</para><para>Bạn có thể <emphasis>xoá dữ liệu của mọi người "
"dùng</emphasis> trên máy tính này và <emphasis>phá hỏng bản cài đặt này "
"không thể sửa chữa.</emphasis> Chỉ thêm một chữ cái vào tên thư mục hay tệp,"
" hoặc vào nội dung của nó, cũng có thể khiến hệ thống <emphasis>không khởi "
"động được.</emphasis></para><para>Có lẽ sẽ không có cảnh báo nào khác, ngay "
"cả khi bạn sắp phá hỏng hệ thống này.</para><para>Bạn nên <emphasis>sao lưu "
"các tệp và thư mục</emphasis> trước khi tiếp tục.</para>"

msgctxt "@title:window"
msgid "Risks of Acting as an Administrator"
msgstr "Rủi ro khi hành động với tư cách Quản trị viên"

msgctxt "@action:button"
msgid "I Understand and Accept These Risks"
msgstr "Tôi hiểu và chấp nhận những rủi ro này"

msgctxt "@option:check"
msgid "Do not warn me about these risks again"
msgstr "Đừng cảnh báo tôi về những rủi ro này nữa"

msgctxt ""
"@action:inmenu Restore the selected files that are in the trash to the place"
" they lived at the moment they were trashed. Minimize the length of this "
"string if possible."
msgid "Restore to Former Location"
msgid_plural "Restore to Former Locations"
msgstr[0] "Khôi phục về vị trí cũ"

msgctxt ""
"@action:inmenu Shortcut, middle click to trigger menu item, keep short"
msgid "Middle Click"
msgstr "Nhấn chuột giữa"

msgctxt ""
"@action:inmenu Shortcut, shift + middle click to trigger menu item, keep "
"short"
msgid "Shift+Middle Click"
msgstr "Shift+Nhấn chuột giữa"

msgctxt "@info"
msgid "Cannot paste: The clipboard is empty."
msgstr "Không thể dán: Bảng tạm trống."

msgctxt "@info"
msgid "Cannot paste: You do not have permission to write into this folder."
msgstr "Không thể dán: Bạn không có quyền ghi vào thư mục này."

msgctxt "@info"
msgid ""
"Cannot create new file: You do not have permission to create items in this "
"folder."
msgstr "Không thể tạo tệp mới: Bạn không có quyền tạo mục trong thư mục này."

msgctxt "@info"
msgid ""
"Cannot create new folder: You do not have permission to create items in this"
" folder."
msgstr ""
"Không thể tạo thư mục mới: Bạn không có quyền tạo mục trong thư mục này."

msgctxt "@info"
msgid "Cannot create new subfolder: Select a single folder you can write to."
msgstr ""
"Không thể tạo thư mục con mới: Hãy chọn một thư mục duy nhất mà bạn có quyền"
" ghi."

msgctxt "@info:whatsthis"
msgid ""
"This opens a new window just like this one with the current "
"location.<nl/>You can drag and drop items between windows."
msgstr ""
"Hành động này mở một cửa sổ mới giống như cửa sổ này với vị trí hiện "
"tại.<nl/>Bạn có thể kéo thả các mục giữa các cửa sổ."

msgctxt "@info:whatsthis"
msgid ""
"This opens a new <emphasis>Tab</emphasis> with the current "
"location.<nl/>Tabs allow you to quickly switch between multiple locations "
"and views within this window. You can drag and drop items between tabs."
msgstr ""
"Hành động này mở một <emphasis>Thẻ</emphasis> mới với vị trí hiện "
"tại.<nl/>Thẻ cho phép bạn nhanh chóng chuyển giữa nhiều vị trí và khung xem "
"trong cửa sổ này. Bạn có thể kéo thả các mục giữa các thẻ."

msgctxt "@info"
msgid "Close Tab"
msgstr "Đóng thẻ"

msgctxt "@info:whatsthis"
msgid ""
"This closes the currently viewed tab. If no more tabs are left, this closes "
"the whole window instead."
msgstr ""
"Hành động này đóng thẻ đang xem. Nếu không còn thẻ nào, nó sẽ đóng cả cửa "
"sổ."

msgctxt "@action:inmenu"
msgid "Copy to Other View"
msgstr "Chép sang khung xem kia"

msgctxt "@action:inmenu"
msgid "Copy to Other View…"
msgstr "Chép sang khung xem kia…"

msgctxt "@info:whatsthis Copy"
msgid ""
"This copies the selected items from the view in focus to the other view. "
"(Only available while in Split View mode.)"
msgstr ""
"Hành động này chép các mục được chọn từ khung xem đang nhắm sang khung xem "
"kia. (Chỉ khả dụng trong chế độ Xem chia đôi.)"

msgctxt "@action:inmenu Edit"
msgid "Copy to Other View"
msgstr "Chép sang khung xem kia"

msgctxt "@action:inmenu"
msgid "Move to Other View"
msgstr "Chuyển sang khung xem kia"

msgctxt "@action:inmenu"
msgid "Move to Other View…"
msgstr "Chuyển sang khung xem kia…"

msgctxt "@info:whatsthis Move"
msgid ""
"This moves the selected items from the view in focus to the other view. "
"(Only available while in Split View mode.)"
msgstr ""
"Hành động này chuyển các mục được chọn từ khung xem đang nhắm sang khung xem"
" kia. (Chỉ khả dụng trong chế độ Xem chia đôi.)"

msgctxt "@action:inmenu Edit"
msgid "Move to Other View"
msgstr "Chuyển sang khung xem kia"

msgctxt "@action:inmenu"
msgid "Focus Other View"
msgstr "Nhắm vào khung xem kia"

msgctxt "@info:tooltip"
msgid "Move keyboard focus to the inactive view."
msgstr "Chuyển tiêu điểm bàn phím sang khung xem không hoạt động."

msgctxt "@action:inmenu Tools"
msgid "Filter…"
msgstr "Lọc…"

msgctxt "@info:whatsthis"
msgid ""
"This opens the <emphasis>Filter Bar</emphasis> at the bottom of the "
"window.<nl/> There you can enter text to filter the files and folders "
"currently displayed. Only those that contain the text in their name will be "
"kept in view."
msgstr ""
"Hành động này mở <emphasis>Thanh lọc</emphasis> ở dưới cùng cửa sổ.<nl/> Tại"
" đó bạn có thể nhập chữ để lọc các tệp và thư mục đang hiển thị. Chỉ những "
"cái có tên chứa phần chữ đó mới được giữ lại trong khung xem."

msgid "Search…"
msgstr "Tìm kiếm…"

msgctxt "@info:whatsthis find"
msgid ""
"<para>This helps you find files and folders by opening a <emphasis>search "
"bar</emphasis>. There you can enter search terms and specify settings to "
"find the items you are looking for.</para>"
msgstr ""
"<para>Hành động này giúp bạn tìm tệp và thư mục bằng cách mở một "
"<emphasis>thanh tìm kiếm</emphasis>. Tại đó bạn có thể nhập từ khoá và chỉ "
"định thiết lập để tìm các mục bạn cần.</para>"

msgctxt "@info:whatsthis invert"
msgid ""
"This selects all items that you have currently <emphasis>not</emphasis> "
"selected instead."
msgstr ""
"Hành động này chọn tất cả các mục mà hiện bạn <emphasis>không</emphasis> "
"chọn."

msgctxt "@info:whatsthis split"
msgid ""
"<para>This presents a second view side-by-side with the current view, so you"
" can see the contents of two folders at once and easily move items between "
"them.</para><para>The view that is not \"in focus\" will be dimmed. "
"</para>Click this button again to close one of the views."
msgstr ""
"<para>Hành động này hiển thị một khung xem thứ hai cạnh khung xem hiện tại, "
"để bạn có thể xem nội dung của hai thư mục cùng lúc và dễ dàng chuyển các "
"mục giữa chúng.</para><para>Khung xem không \"được nhắm\" sẽ bị làm mờ. "
"</para>Bấm nút này lần nữa để đóng một trong hai khung xem."

msgctxt "@info:whatsthis"
msgid ""
"If the view has been split, this will pop the view in focus out into a new "
"window."
msgstr ""
"Nếu khung xem đã được chia đôi, hành động này sẽ tách khung xem đang nhắm ra"
" một cửa sổ mới."

msgctxt "@info:tooltip"
msgid "Refresh view"
msgstr "Làm mới khung xem"

msgctxt "@info:whatsthis refresh"
msgid ""
"<para>This refreshes the folder view.</para><para>If the contents of this "
"folder have changed, refreshing will re-scan this folder and show you a "
"newly-updated view of the files and folders contained here.</para><para>If "
"the view is split, this refreshes the one that is currently in focus.</para>"
msgstr ""
"<para>Hành động này làm mới khung xem thư mục.</para><para>Nếu nội dung thư "
"mục này đã thay đổi, việc làm mới sẽ quét lại thư mục và hiển thị cho bạn "
"khung xem cập nhật mới nhất về các tệp và thư mục ở đây.</para><para>Nếu "
"khung xem đang chia đôi, hành động này làm mới khung đang được nhắm.</para>"

msgctxt "@info:whatsthis"
msgid ""
"This undoes the last change you made to files or folders.<nl/>Such changes "
"include <interface>creating</interface>, <interface>renaming</interface> and"
" <interface>moving</interface> them to a different location or to the "
"<filename>Trash</filename>. <nl/>Any changes that cannot be undone will ask "
"for your confirmation beforehand."
msgstr ""
"Hành động này hoàn tác thay đổi cuối cùng bạn đã thực hiện với tệp hoặc thư "
"mục.<nl/>Các thay đổi đó bao gồm <interface>tạo</interface>, <interface>đổi "
"tên</interface> và <interface>chuyển</interface> chúng sang vị trí khác hoặc"
" vào <filename>Thùng rác</filename>. <nl/>Mọi thay đổi không thể hoàn tác sẽ"
" hỏi xác nhận của bạn trước."

msgctxt "@info:whatsthis"
msgid ""
"This redoes the last change you undid.<nl/>Such changes include "
"<interface>creating</interface>, <interface>renaming</interface> and "
"<interface>moving</interface> files or folders to a different location or to"
" the <filename>Trash</filename>.<nl/>Any changes that cannot be undone will "
"ask for your confirmation beforehand."
msgstr ""
"Hành động này làm lại thay đổi cuối cùng bạn đã hoàn tác.<nl/>Các thay đổi "
"đó bao gồm <interface>tạo</interface>, <interface>đổi tên</interface> và "
"<interface>chuyển</interface> tệp hoặc thư mục sang vị trí khác hoặc vào "
"<filename>Thùng rác</filename>.<nl/>Mọi thay đổi không thể hoàn tác sẽ hỏi "
"xác nhận của bạn trước."

msgctxt "@info:whatsthis"
msgid ""
"Go to your <filename>Home</filename> folder.<nl/>Every user account has "
"their own <filename>Home</filename> that contains their personal files, as "
"well as hidden folders for their applications' data and configuration files."
msgstr ""
"Đi tới <filename>Thư mục chính</filename> của bạn.<nl/>Mỗi tài khoản người "
"dùng có <filename>Thư mục chính</filename> riêng, chứa các tệp cá nhân cũng "
"như các thư mục ẩn chứa dữ liệu và tệp cấu hình của ứng dụng."

msgctxt "@action:inmenu Tools"
msgid "Manage Disk Space Usage"
msgstr "Quản lí sử dụng dung lượng đĩa"

msgctxt "@info:whatsthis"
msgid ""
"<para>This opens a <emphasis>terminal</emphasis> application for the viewed "
"location.</para><para>To learn more about terminals use the help features in"
" the terminal application.</para>"
msgstr ""
"<para>Hành động này mở một ứng dụng <emphasis>dòng lệnh</emphasis> cho vị "
"trí đang xem.</para><para>Để tìm hiểu thêm về dòng lệnh, hãy dùng tính năng "
"trợ giúp trong ứng dụng dòng lệnh.</para>"

msgctxt "@info:whatsthis"
msgid ""
"<para>This opens <emphasis>terminal</emphasis> applications for the selected"
" items' locations.</para><para>To learn more about terminals use the help "
"features in the terminal application.</para>"
msgstr ""
"<para>Hành động này mở các ứng dụng <emphasis>dòng lệnh</emphasis> cho vị "
"trí của các mục được chọn.</para><para>Để tìm hiểu thêm về dòng lệnh, hãy "
"dùng tính năng trợ giúp trong ứng dụng dòng lệnh.</para>"

msgctxt "@info:whatsthis"
msgid ""
"<para>This switches between having a <emphasis>Menubar</emphasis> and having"
" an <interface>%1</interface> button. Both contain mostly the same actions "
"and configuration options.</para><para>The Menubar takes up more space but "
"allows for fast and organized access to all actions an application has to "
"offer.</para><para>The %1 button is simpler and small which makes triggering"
" advanced actions more time consuming.</para>"
msgstr ""
"<para>Lựa chọn này chuyển đổi giữa việc có một <emphasis>Thanh trình "
"đơn</emphasis> và có một nút <interface>%1</interface>. Cả hai hầu như chứa "
"cùng các hành động và tuỳ chọn cấu hình.</para><para>Thanh trình đơn chiếm "
"nhiều chỗ hơn nhưng cho phép truy cập nhanh và có tổ chức tới mọi hành động "
"mà một ứng dụng cung cấp.</para><para>Nút %1 đơn giản và nhỏ hơn, khiến việc"
" kích hoạt các hành động nâng cao tốn thời gian hơn.</para>"

msgctxt "@action:inmenu"
msgid "Go to Tab %1"
msgstr "Đi tới thẻ %1"

msgctxt "@action:inmenu"
msgid "Last Tab"
msgstr "Thẻ cuối"

msgctxt "@action:inmenu"
msgid "Go to Last Tab"
msgstr "Đi tới thẻ cuối"

msgctxt "@action:inmenu"
msgid "Go to Next Tab"
msgstr "Đi tới thẻ sau"

msgctxt "@action:inmenu"
msgid "Go to Previous Tab"
msgstr "Đi tới thẻ trước"

msgctxt "@action:inmenu"
msgid "Open in Split View"
msgstr "Mở trong khung xem chia đôi"

msgid "&Window Color Scheme"
msgstr "Lược đồ màu &cửa sổ"

msgctxt "@info:whatsthis"
msgid ""
"<para>This toggles the <emphasis>terminal</emphasis> panel at the bottom of "
"the window.<nl/>The location in the terminal will always match the folder "
"view so you can navigate using either.</para><para>The terminal panel is not"
" needed for basic computer usage but can be useful for advanced tasks. To "
"learn more about terminals use the help features in a standalone terminal "
"application like Konsole.</para>"
msgstr ""
"<para>Hành động này bật/tắt bảng <emphasis>dòng lệnh</emphasis> ở dưới cùng "
"cửa sổ.<nl/>Vị trí trong dòng lệnh sẽ luôn khớp với khung xem thư mục nên "
"bạn có thể điều hướng bằng cái nào cũng được.</para><para>Bảng dòng lệnh "
"không cần cho việc dùng máy tính cơ bản nhưng có thể hữu ích cho các tác vụ "
"nâng cao. Để tìm hiểu thêm về dòng lệnh, hãy dùng tính năng trợ giúp trong "
"một ứng dụng dòng lệnh độc lập như Konsole.</para>"

msgctxt "@info:whatsthis"
msgid ""
"<para>This is the <emphasis>terminal</emphasis> panel. It behaves like a "
"normal terminal but will match the location of the folder view so you can "
"navigate using either.</para><para>The terminal panel is not needed for "
"basic computer usage but can be useful for advanced tasks. To learn more "
"about terminals use the help features in a standalone terminal application "
"like Konsole.</para>"
msgstr ""
"<para>Đây là bảng <emphasis>dòng lệnh</emphasis>. Nó hoạt động như một ứng "
"dụng dòng lệnh bình thường nhưng sẽ khớp với vị trí của khung xem thư mục "
"nên bạn có thể điều hướng bằng cái nào cũng được.</para><para>Bảng dòng lệnh"
" không cần cho việc dùng máy tính cơ bản nhưng có thể hữu ích cho các tác vụ"
" nâng cao. Để tìm hiểu thêm về dòng lệnh, hãy dùng tính năng trợ giúp trong "
"một ứng dụng dòng lệnh độc lập như Konsole.</para>"

msgctxt "@info:tooltip"
msgid "Move keyboard focus to and from the Terminal panel."
msgstr "Chuyển tiêu điểm bàn phím tới và rời khỏi bảng Dòng lệnh."

msgctxt "@action:inmenu"
msgid "Follow Directory Switch"
msgstr "Theo chuyển đổi thư mục"

msgctxt "@info:tooltip"
msgid ""
"Determines if current working directory must be kept in sync with terminal "
"whenever directory is changed."
msgstr ""
"Xác định xem thư mục làm việc hiện tại có phải được đồng bộ với dòng lệnh "
"mỗi khi đổi thư mục hay không."

msgctxt "@info:whatsthis"
msgid ""
