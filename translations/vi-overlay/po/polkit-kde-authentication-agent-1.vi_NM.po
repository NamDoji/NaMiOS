msgid "Select User"
msgstr "Chọn người dùng"

msgid "Another client is already authenticating, please try again later."
msgstr "Một chương trình khác đang xác thực, vui lòng thử lại sau."

msgctxt "Error response when polkit calls us with an empty list of identities"
msgid "No user to authenticate as. Please check your system configuration."
msgstr ""
"Không có người dùng nào để xác thực. Vui lòng kiểm tra cấu hình hệ thống."

msgid "Authentication Required"
msgstr "Cần xác thực"

msgid "Authentication failure, please try again."
msgstr "Xác thực không thành công, vui lòng thử lại."

msgid "Change user"
msgstr "Đổi người dùng"

msgid "Authenticating as %1"
msgstr "Đang xác thực với tư cách %1"

msgid "Password…"
msgstr "Mật khẩu…"

msgid "OK"
msgstr "OK"

msgid "Cancel"
msgstr "Hủy"

msgid "User: %1"
msgstr "Người dùng: %1"

msgid "Details"
msgstr "Chi tiết"

msgid "Action:"
msgstr "Hành động:"

msgid "ID:"
msgstr "Mã:"

msgid "Vendor:"
msgstr "Nhà cung cấp:"

msgctxt "@action:button Switches user used for authorization"
msgid "Switch…"
msgstr "Chuyển…"
