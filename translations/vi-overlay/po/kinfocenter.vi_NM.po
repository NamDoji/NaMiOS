# NaMiOS vi_NM translation overlay — kinfocenter (Plasma 6.3.6 · Debian 13 trixie).
# Source branch: Plasma/6.3
# https://invent.kde.org/plasma/kinfocenter/-/tree/Plasma/6.3/po (kinfocenter: msgid từ po/fr; kcm_*: po/vi)
# Byte-exact msgid/msgctxt/msgid_plural from the real KDE catalogs; fuzzy flags
# dropped after review. Installs to /usr/share/locale/vi_NM/LC_MESSAGES/<domain>.mo
# with LANGUAGE=vi_NM:vi:en_US (per-message fallback vi_NM -> vi -> en).
# One compiled .mo is copied to EVERY domain in X-NaMiOS-Source-Domains;
# msgctxt keeps each app matching only its own strings.
msgid ""
msgstr ""
"Project-Id-Version: NaMiOS vi_NM overlay — kinfocenter (Plasma 6.3.6 · Debian 13 trixie)\n"
"Report-Msgid-Bugs-To: https://bugs.kde.org\n"
"PO-Revision-Date: 2026-11-07 00:00+0700\n"
"Last-Translator: NaMiOS vi_NM overlay\n"
"Language-Team: Vietnamese <kde-i18n-doc@kde.org>\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Accelerator-Marker: &\n"
"X-NaMiOS-Overlay: vi_NM\n"
"X-NaMiOS-Source-Branch: Plasma/6.3\n"
"X-NaMiOS-Source-Domains: kinfocenter, kcm_about-distro, kcm_energyinfo\n"

# domain: kinfocenter [override]
#, kde-kuit-format
msgctxt "@info"
msgid ""
"The <command>%1</command> tool is required to display this page, but could "
"not be found"
msgstr ""
"Cần công cụ <command>%1</command> để hiển thị trang này, nhưng không tìm "
"thấy nó"

# domain: kinfocenter [override]
#, kde-kuit-format
msgctxt "@info"
msgid ""
"You can search for it and install it using your package manager.<nl/>Then "
"please report this packaging issue to your distribution."
msgstr ""
"Bạn có thể tìm và cài nó bằng trình quản lý gói.<nl/>Sau đó, vui lòng báo "
"lỗi đóng gói này cho bản phân phối của bạn."

# domain: kinfocenter [override]
#, kde-kuit-format
msgctxt "@info"
msgid "The <command>%1</command> tool crashed while generating page content"
msgstr "Công cụ <command>%1</command> đã sập khi tạo nội dung trang"

# domain: kinfocenter [override]
#, kde-kuit-format
msgctxt "@Info"
msgid ""
"Try again later. If keeps happening, please report the crash to your "
"distribution."
msgstr ""
"Hãy thử lại sau. Nếu vẫn xảy ra, vui lòng báo sự cố này cho bản phân phối "
"của bạn."

