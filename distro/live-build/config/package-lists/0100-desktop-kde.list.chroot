# NaMiOS — desktop KDE Plasma (DAC_TA_HE_DIEU_HANH.md §5.1 "Desktop":
# "KDE Plasma, Dolphin và thiết lập riêng bằng gói Debian; dùng gói từ
# nguồn được duy trì; không viết lại desktop").
#
# verified_on_host: NO — tên gói dưới đây PHẢI xác nhận lại bằng
# `apt-cache show <ten>` trên build host Debian 13 trixie thật trước khi
# build (điều kiện spike ADR 0002). Nếu một tên gói sai, `lb build` sẽ
# báo lỗi rõ ("unable to locate package") — sửa tên rồi build lại, không
# bỏ qua dòng lỗi.
#
# live-build bỏ qua dòng bắt đầu bằng "#"; mỗi dòng còn lại = 1 tên gói.

task-kde-desktop
# kwin-x11 = window manager X11 (kwin_x11). BAT BUOC cho phien plasmax11 (SDDM
# autologin Session=plasmax11, hook 0400): plasma-desktop chi Recommends
# "kwin-wayland | kwin-x11", apt co the chi cai kwin-wayland -> phien X11 KHONG
# CO WM -> autologin vao phien "chet" -> KET o man dang nhap (su co wave2/2.1,
# chap chon theo tung build). Ghi TUONG MINH de phien X11 luon co WM. (Goi cu
# "plasma-workspace-x11" KHONG ton tai trong trixie -> da bi drop im lang;
# /usr/share/xsessions/plasmax11.desktop do chinh plasma-workspace ship.) verified_on_host: NO.
kwin-x11
sddm
# sddm-theme-breeze = theme breeze cho SDDM (NaMiOS ghi đè qua theme.conf.user →
# nền wallpaper sen). Không có gói này thì theme.conf.user "mồ côi". verified_on_host: NO.
sddm-theme-breeze
dolphin
dolphin-plugins
konsole
kate
plasma-discover
plasma-nm
plasma-pa
kscreen
ark
okular
kde-spectacle
# Mesa software rasterizer (llvmpipe/swrast). May KHONG GPU (QEMU/TCG, VM, may cu):
# moi GL probe se load driver nay va ve BANG SOFTWARE thay vi man den. Bo tro cho
# hook 0400 (LIBGL_ALWAYS_SOFTWARE) + kwinrc compositing=off. verified_on_host: NO.
libgl1-mesa-dri
# Backend để Trung tâm phần mềm (Discover) quản lý + CẬP NHẬT gói hệ thống + metadata danh mục.
packagekit
appstream
