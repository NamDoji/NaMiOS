#!/bin/bash
# NaMiOS — DEMO/CAPTURE lần đăng nhập ĐẦU: chứng minh BỘ GÕ TIẾNG VIỆT chạy
# thật (yêu cầu Cuong 10/11/2026: "ảnh chụp thật bộ gõ tiếng việt").
#
# Hook này CHỈ ghi 1 file autostart gọi script demo đã ship sẵn
# (/usr/local/bin/namios-demo-first-login.sh). TOÀN BỘ logic (mở fcitx5 +
# bảng điều khiển Unikey + KWrite + gõ thử Telex) nằm trong script đó.
#
# VÌ SAO KHÔNG nhét logic vào Exec= nữa (bài học build 42682757792): trường
# Exec trong .desktop CẤM ký tự nháy kép ("). Bản demo cũ nhét
# `xdotool ... "KWrite"` + `type "..."` thẳng vào Exec -> .desktop hỏng cú
# pháp -> autostart KHÔNG chạy, KHÔNG cửa sổ nào hiện (cả Impress cũng không
# mở). Tách ra script .sh thì Exec chỉ còn 1 đường dẫn, hết lỗi quoting.
#
# Script tự xoá file autostart của chính nó sau lần chạy đầu => máy CÀI THẬT
# chỉ demo ở lần đăng nhập đầu; live ISO không lưu phiên nên mỗi boot vẫn chạy
# (đúng mục đích demo/chụp).
#
# verified_on_host: NO — xem ghi chú trong chính script về giới hạn xdotool->
# fcitx dưới QEMU. AN TOAN (CLAUDE.md): set -euo pipefail; KHONG curl|bash;
# KHONG eval; chỉ ghi 1 file autostart tĩnh + chmod script tĩnh trong chroot.

set -euo pipefail

# Mac dinh KHONG tu chay demo mo-app tren ban ISO that (yeu cau Cuong
# 10/11/2026: "bo che do chay tu dong cac phan mem" — PDF/go-tieng-Viet). Che
# do demo/chup-bang-chung CHI bat khi build voi bien moi truong
# NAMIOS_BUILD_DEMO_CAPTURE=1 (build lay screenshot), con lai luon bo qua.
if [ "${NAMIOS_BUILD_DEMO_CAPTURE:-0}" != "1" ]; then
  rm -f /etc/skel/.config/autostart/namios-demo-first-login.desktop \
        /etc/skel/.config/autostart/namios-demo-office.desktop \
        /etc/skel/.config/autostart/namios-demo-open-apps.desktop 2>/dev/null || true
  echo "namios-hook 0500: BO QUA demo tu-mo-app (NAMIOS_BUILD_DEMO_CAPTURE!=1) — ISO that khong tu chay PDF/go-tieng-Viet. verified_on_host: NO"
  exit 0
fi

DEMO="/usr/local/bin/namios-demo-first-login.sh"
if [ -f "$DEMO" ]; then
  chmod 0755 "$DEMO"
  echo "namios-hook 0500: chmod 0755 $DEMO"
else
  echo "namios-hook 0500: CANH BAO khong thay $DEMO — demo se khong chay (verified_on_host: NO)"
fi

mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/namios-demo-first-login.desktop <<EOF
[Desktop Entry]
Type=Application
Name=NaMiOS demo bộ gõ tiếng Việt (chỉ lần đầu)
Name[vi]=NaMiOS demo bộ gõ tiếng Việt (chỉ lần đầu)
Exec=${DEMO}
X-KDE-autostart-phase=2
NoDisplay=true
EOF
chmod 0644 /etc/skel/.config/autostart/namios-demo-first-login.desktop

# Gỡ các file autostart demo CŨ (bản nhét script vào Exc -> hỏng) nếu còn sót
# từ build trước, tránh chạy trùng/lỗi.
rm -f /etc/skel/.config/autostart/namios-demo-office.desktop \
      /etc/skel/.config/autostart/namios-demo-open-apps.desktop 2>/dev/null || true

echo "namios-hook 0500: autostart goi ${DEMO} (bo go tieng Viet) 1 lan, tu xoa sau — verified_on_host: NO"
