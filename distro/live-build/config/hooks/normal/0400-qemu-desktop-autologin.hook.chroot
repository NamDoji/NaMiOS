#!/bin/bash
# NaMiOS — cho phep BOOT HIEN HINH tren may KHONG co GPU (QEMU/TCG, VM, may cu):
#   (1) SDDM autologin vao phien Plasma X11 -> bo qua greeter. Duoi TCG greeter
#       Qt Quick render DEN THUI chi con con tro chuot -> ket o man den mai mai
#       (su co 06/11: frame_04min+ = den + con tro, Plasma khong bao gio hien).
#   (2) Ep software rendering (LIBGL_ALWAYS_SOFTWARE/QT_QUICK_BACKEND) -> KHONG
#       can OpenGL. Compositing KWin bi TAT o kwinrc -> plasmashell ve wallpaper
#       + panel bang raster X11 thuan, khong dung GPU.
#   (3) Tat screen-blank/DPMS -> frame chup khong bi den sau vai phut idle.
#
# verified_on_host: NO — chua chay qua `lb build`/boot that; soan theo tai lieu
# SDDM (sddm.conf.d, [Autologin] User/Session) + pam_env (/etc/environment).
# PHAI boot that de xac nhan. Neu Session=plasmax11 sai ten (thieu goi
# plasma-workspace-x11), SDDM log bao ro -> doi ten file trong
# /usr/share/xsessions/. Live user mac dinh cua Debian live-config = 'user'.
#
# AN TOAN (CLAUDE.md): set -euo pipefail; KHONG curl|bash; KHONG eval; KHONG
# tai/thuc thi noi dung tu xa; chi ghi file cau hinh tinh trong chroot.

set -euo pipefail

# (1) SDDM autologin — ten 'zz-' de sap xep CUOI, override config conf.d khac.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-namios-autologin.conf <<'EOF'
[Autologin]
User=user
Session=plasmax11.desktop
# Relogin=true = LƯỚI AN TOÀN quyết định: nếu phiên plasmax11 thoát/sập (vd theme
# nặng dưới software-raster QEMU), autologin BẮN LẠI ngay thay vì kẹt greeter đòi
# mật khẩu vĩnh viễn (đúng gốc sự cố wave2/2.1: Relogin=false biến 1-lần-sập-phiên
# thành ngõ-cụt-greeter). Phiên khoẻ thì vô hại.
Relogin=true

[General]
# Giữ DisplayServer=x11: chốt greeter về X11 (nếu greeter lộ ra dưới QEMU thì không
# rơi vào Wayland-greeter đen). + software GL + LANG VN cho đồng hồ greeter tiếng Việt.
DisplayServer=x11
GreeterEnvironment=QT_QUICK_BACKEND=software,QT_XCB_FORCE_SOFTWARE_OPENGL=1,LIBGL_ALWAYS_SOFTWARE=1,LANG=vi_VN.UTF-8

[Theme]
Current=breeze
EOF

# (1b) EP X11: AN cac phien Wayland de SDDM CHI con phien X11 (plasmax11).
# BANG CHUNG (build 9254d6a): theme da tat nhung Wayland con -> mot phien Wayland
# khoi dong -> kwin_WAYLAND CRASH-LOOP trong QEMU headless (khong GPU/EGL) -> Plasma
# shell/panel khong len. Bản "recover" chay X11 (kwin_x11 + software raster) thi
# chay tot. Wayland Plasma 6 CAN GPU; VM + may cu KHONG co -> BAT BUOC X11.
# (Tradeoff: ban CAI tren may thuc cung mat Wayland; chap nhan cho alpha "chay moi noi",
# se VM-gate boot-time sau de may GPU thuc giu Wayland.) verified_on_host: NO.
for _ws in /usr/share/wayland-sessions/*.desktop; do
  [ -e "$_ws" ] && mv -f "$_ws" "$_ws.disabled" 2>/dev/null || true
done

# (2) Software rendering cho CA phien (pam_env doc /etc/environment luc login).
touch /etc/environment
for kv in \
  "LIBGL_ALWAYS_SOFTWARE=1" \
  "QT_QUICK_BACKEND=software" \
  "QT_XCB_FORCE_SOFTWARE_OPENGL=1" \
  "GTK_IM_MODULE=fcitx" \
  "QT_IM_MODULE=fcitx" \
  "XMODIFIERS=@im=fcitx" ; do
    key="${kv%%=*}"
    grep -q "^${key}=" /etc/environment || printf '%s\n' "$kv" >> /etc/environment
done

# Backstop: phien X11 source /etc/profile -> /etc/profile.d/*.sh.
cat > /etc/profile.d/namios-softgl.sh <<'EOF'
# NaMiOS — ep software GL tren may khong GPU (QEMU/TCG/VM may cu)
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QUICK_BACKEND=software
export QT_XCB_FORCE_SOFTWARE_OPENGL=1
EOF
chmod 0644 /etc/profile.d/namios-softgl.sh

# (3) Tat screen-blank/DPMS trong phien moi user (tranh frame den sau idle).
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/namios-noblank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=NaMiOS no-blank (VM/QEMU)
Exec=sh -c "xset s off; xset -dpms; xset s noblank"
X-KDE-autostart-phase=1
NoDisplay=true
EOF

# (4) EP AP wallpaper thuong hieu sau khi plasmashell da len. Ly do: file
# plasma-org.kde.plasma.desktop-appletsrc pre-seed co the bi Plasma danh so lai
# containment lan dang nhap dau -> KHONG nhan -> desktop ve nen DEN (su co
# 06/11: frame_06min desktop Plasma that nhung nen den, khong co wallpaper ruby).
# plasma-apply-wallpaperimage (goi plasma-workspace) dat wallpaper qua D-Bus cho
# phien dang chay -> tat dinh, khong phu thuoc so containment. Vong lap retry vi
# autostart co the chay truoc khi plasmashell san sang D-Bus.
install -D -m 0755 /dev/stdin /usr/local/bin/namios-apply-wallpaper.sh <<'EOF'
#!/bin/sh
# NaMiOS — ep ap wallpaper thuong hieu cho phien Plasma dang chay (retry toi khi
# plasmashell san sang tren D-Bus) + dong cua so "Welcome Center" cua Debian
# (plasma-welcome) neu no mo (che logo "N" giua wallpaper). Idempotent, luon
# exit 0 (khong chan login).
# Hinh nen DESKTOP mac dinh = Vinh Ha Long (Cuong chon anh dep nhat trong 20 anh
# VN). SDDM/Plymouth van giu logo thuong hieu nga (file namios-default.png khac).
WP=/usr/share/backgrounds/namios/namios-desktop-default.png
# Nen: trong ~25s dau phien, lien tuc dong plasma-welcome (no mo cham sau login).
# pkill -f chi khop tien trinh "plasma-welcome", KHONG khop "namios-welcome".
( j=0
  while [ "$j" -lt 25 ]; do
    kquitapp6 plasma-welcome 2>/dev/null \
      || kquitapp5 plasma-welcome 2>/dev/null \
      || pkill -f '[p]lasma-welcome' 2>/dev/null || true
    j=$((j + 1))
    sleep 1
  done ) &
[ -f "$WP" ] || exit 0
i=0
while [ "$i" -lt 30 ]; do
  if plasma-apply-wallpaperimage "$WP" >/dev/null 2>&1; then
    exit 0
  fi
  i=$((i + 1))
  sleep 2
done
exit 0
EOF
cat > /etc/skel/.config/autostart/namios-wallpaper.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=NaMiOS apply wallpaper
Exec=/usr/local/bin/namios-apply-wallpaper.sh
X-KDE-autostart-phase=2
NoDisplay=true
EOF

# (5) Tat "Welcome Center" (goi plasma-welcome keo theo tu task-kde-desktop):
# cua so nay tu mo lan dau, che wallpaper + ghi "Welcome to Debian" -> khong hop
# thuong hieu NaMiOS va che mat desktop khi chup. GO HAN o BUILD-TIME: xoa binary
# + MOI autostart + .desktop launcher. Quyet liet hon vong lap kquitapp runtime o
# (4) (co the thua lan dau boot: su co d39006b = Welcome Center VAN mo giua man).
# Xoa binary => khong con gi de autostart/kded khoi dong lai duoc.
rm -f /usr/bin/plasma-welcome /usr/bin/plasma-welcome6 /usr/bin/org.kde.plasma.welcome 2>/dev/null || true
rm -f /etc/xdg/autostart/*welcome*.desktop /etc/xdg/autostart/*Welcome*.desktop 2>/dev/null || true
find /usr/share/applications -iname '*welcome*.desktop' -delete 2>/dev/null || true

# (6) HINH NEN RUBY — BAO DAM o BUILD-TIME (tat dinh). Ly do: su co d39006b cho
# thay plasma-apply-wallpaperimage o (4) la RUNTIME (phu thuoc D-Bus + so
# containment Plasma tu danh lai) -> KHONG ap duoc -> desktop ve hinh nen MAC
# DINH cua KDE (gradient tim/xanh Breeze). Cach chac an: GHI DE chinh file anh
# mac dinh cua KDE bang anh thuong hieu NaMiOS. Du Plasma khong doc config
# pre-seed hay D-Bus that bai, hinh nen render ra VAN la NaMiOS. Khong phu thuoc
# runtime, khong phu thuoc ten lenh/goi nao.
RUBY=/usr/share/backgrounds/namios/namios-desktop-default.png
if [ -f "$RUBY" ]; then
  # Ghi de goi wallpaper MAC DINH cua Plasma 6 ("Next") bang anh Ha Long -> desktop
  # mac dinh = Ha Long ngay ca truoc khi (4) runtime ap. CHI dung "Next" (khong ghi
  # de TAT CA 124 anh stock nhu truoc) vi anh Ha Long ~3.5MB, x124 se phinh ISO ~400MB;
  # (4) runtime plasma-apply-wallpaperimage da lo mọi goi khac. KHONG dung bo VN NaMiOS-*.
  n=0
  while IFS= read -r -d '' f; do
    cp -f "$RUBY" "$f" 2>/dev/null && n=$((n + 1)) || true
  done < <(find /usr/share/wallpapers/Next -type f \
             \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
             -path '*/contents/*' -print0 2>/dev/null)
  echo "namios-hook 0400: ghi de $n anh wallpaper goi Next = Ha Long (desktop mac dinh)"
else
  echo "namios-hook 0400: CANH BAO — khong thay $RUBY, bo qua ghi de wallpaper"
fi

echo "namios-hook 0400: SDDM autologin plasmax11 + software GL + tat blank/lock + ep+ghi-de wallpaper ruby + go han welcome (verified_on_host: NO)"
