#!/bin/bash
# NaMiOS — cho phep BOOT HIEN HINH tren may KHONG co GPU (QEMU/TCG, VM, may cu):
#   (1) SDDM autologin vao phien Plasma X11 -> bo qua greeter. Duoi TCG greeter
#       Qt Quick render DEN THUI chi con con tro chuot -> ket o man den mai mai
#       (su co 06/11: frame_04min+ = den + con tro, Plasma khong bao gio hien).
#   (2) Ep software rendering (LIBGL_ALWAYS_SOFTWARE/QT_QUICK_BACKEND) -> KHONG
#       can OpenGL. Compositing KWin bi TAT o kwinrc -> plasmashell ve wallpaper
#       + panel bang raster X11 thuan, khong dung GPU.
#   (3) Tat screen-blank/DPMS -> frame chup khong bi den sau vai phut idle.
#
# verified_on_host: NO — chua chay qua `lb build`/boot that; soan theo tai lieu
# SDDM (sddm.conf.d, [Autologin] User/Session) + pam_env (/etc/environment).
# PHAI boot that de xac nhan. Neu Session=plasmax11 sai ten (thieu goi
# plasma-workspace-x11), SDDM log bao ro -> doi ten file trong
# /usr/share/xsessions/. Live user mac dinh cua Debian live-config = 'user'.
#
# AN TOAN (CLAUDE.md): set -euo pipefail; KHONG curl|bash; KHONG eval; KHONG
# tai/thuc thi noi dung tu xa; chi ghi file cau hinh tinh trong chroot.

set -euo pipefail

# (1) SDDM autologin — ten 'zz-' de sap xep CUOI, override config conf.d khac.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-namios-autologin.conf <<'EOF'
[Autologin]
User=user
Session=plasmax11
Relogin=false

[General]
# QEMU/TCG & VM khong co GPU — greeter cung phai software neu lo hien ra
GreeterEnvironment=QT_QUICK_BACKEND=software,QT_XCB_FORCE_SOFTWARE_OPENGL=1,LIBGL_ALWAYS_SOFTWARE=1

[Theme]
Current=breeze
EOF

# (2) Software rendering cho CA phien (pam_env doc /etc/environment luc login).
touch /etc/environment
for kv in \
  "LIBGL_ALWAYS_SOFTWARE=1" \
  "QT_QUICK_BACKEND=software" \
  "QT_XCB_FORCE_SOFTWARE_OPENGL=1" ; do
    key="${kv%%=*}"
    grep -q "^${key}=" /etc/environment || printf '%s\n' "$kv" >> /etc/environment
done

# Backstop: phien X11 source /etc/profile -> /etc/profile.d/*.sh.
cat > /etc/profile.d/namios-softgl.sh <<'EOF'
# NaMiOS — ep software GL tren may khong GPU (QEMU/TCG/VM may cu)
export LIBGL_ALWAYS_SOFTWARE=1
export QT_QUICK_BACKEND=software
export QT_XCB_FORCE_SOFTWARE_OPENGL=1
EOF
chmod 0644 /etc/profile.d/namios-softgl.sh

# (3) Tat screen-blank/DPMS trong phien moi user (tranh frame den sau idle).
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/namios-noblank.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=NaMiOS no-blank (VM/QEMU)
Exec=sh -c "xset s off; xset -dpms; xset s noblank"
X-KDE-autostart-phase=1
NoDisplay=true
EOF

# (4) EP AP wallpaper thuong hieu sau khi plasmashell da len. Ly do: file
# plasma-org.kde.plasma.desktop-appletsrc pre-seed co the bi Plasma danh so lai
# containment lan dang nhap dau -> KHONG nhan -> desktop ve nen DEN (su co
# 06/11: frame_06min desktop Plasma that nhung nen den, khong co wallpaper ruby).
# plasma-apply-wallpaperimage (goi plasma-workspace) dat wallpaper qua D-Bus cho
# phien dang chay -> tat dinh, khong phu thuoc so containment. Vong lap retry vi
# autostart co the chay truoc khi plasmashell san sang D-Bus.
install -D -m 0755 /dev/stdin /usr/local/bin/namios-apply-wallpaper.sh <<'EOF'
#!/bin/sh
# NaMiOS — ep ap wallpaper thuong hieu cho phien Plasma dang chay (retry toi khi
# plasmashell san sang tren D-Bus). Idempotent, luon exit 0 (khong chan login).
WP=/usr/share/backgrounds/namios/namios-default.png
[ -f "$WP" ] || exit 0
i=0
while [ "$i" -lt 30 ]; do
  if plasma-apply-wallpaperimage "$WP" >/dev/null 2>&1; then
    exit 0
  fi
  i=$((i + 1))
  sleep 2
done
exit 0
EOF
cat > /etc/skel/.config/autostart/namios-wallpaper.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=NaMiOS apply wallpaper
Exec=/usr/local/bin/namios-apply-wallpaper.sh
X-KDE-autostart-phase=2
NoDisplay=true
EOF

# (5) Tat "Welcome Center" (goi plasma-welcome keo theo tu task-kde-desktop):
# cua so nay tu mo lan dau, che wallpaper + ghi "Welcome to Debian" -> khong hop
# thuong hieu NaMiOS va che mat desktop khi chup. Xoa autostart he thong cua no.
rm -f /etc/xdg/autostart/org.kde.plasma.welcome.desktop 2>/dev/null || true

echo "namios-hook 0400: SDDM autologin plasmax11 + software GL + tat blank/lock + ep wallpaper + tat welcome (verified_on_host: NO)"
