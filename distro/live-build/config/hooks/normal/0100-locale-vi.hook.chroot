#!/bin/bash
# NaMiOS — thiet lap locale he thong. Hook nay CHAY TRONG CHROOT luc build
# anh (khong chay tren may nguoi dung, khong chay luc boot Live) — dung
# theo config/hooks/normal/ cua Debian live-build.
#
# QUYET DINH (Cuong, 11/11/2026 — DAO NGUOC quyet dinh 10/11/2026): NaMiOS la
# "he dieu hanh cho nguoi Viet" — mac dinh he thong + UI quay lai TIENG VIET
# (vi_VN.UTF-8, LANGUAGE=vi_NM:vi:en_US) ngay tu dau, khong doi nguoi dung tu
# vao System Settings moi thay duoc tieng me de. Tieng Anh VAN CAI DAY DU va
# chon duoc 1-click qua System Settings -> Region & Language: nguoi dung
# muon dung tieng Anh tu chuyen sang en_US duoc ngay, KHONG can cai them goi
# nao.
#
# verified_on_host: NO — chua chay qua `lb build` nao; da review theo
# Debian Live Manual muc "Live/system scripts (hooks)" [S10].
#
# AN TOAN (CLAUDE.md): khong curl|bash, khong tai noi dung tu xa, khong
# eval, chi dung cong cu da cai qua package-lists (locales/tzdata).

set -euo pipefail

# Ca hai locale deu duoc generate: vi_VN lam mac dinh, en_US de tieng Anh
# chon duoc ngay khong can build lai / cai them goi.
LOCALES=("en_US.UTF-8" "vi_VN.UTF-8")
DEFAULT_LOCALE="vi_VN.UTF-8"

if [ ! -f /etc/locale.gen ]; then
    echo "namios-hook 0100: /etc/locale.gen khong ton tai - goi 'locales' chua cai, kiem tra config/package-lists/0200-locale-vi.list.chroot" >&2
    exit 1
fi

for LOCALE in "${LOCALES[@]}"; do
    if grep -q "^# *${LOCALE} UTF-8" /etc/locale.gen; then
        sed -i "s/^# *${LOCALE} UTF-8/${LOCALE} UTF-8/" /etc/locale.gen
    elif ! grep -q "^${LOCALE} UTF-8" /etc/locale.gen; then
        printf '%s UTF-8\n' "${LOCALE}" >> /etc/locale.gen
    fi
done

locale-gen
# LANG = locale he thong mac dinh = vi_VN (dung voi muc tieu "OS cho nguoi
# Viet"). Ep LANGUAGE=vi_NM:vi:en_US de uu tien lop phu dich vi_NM cua
# NaMiOS truoc, roi `vi` upstream, roi moi roi ve `en` — per-message
# fallback, KHONG bao gio trang trong. Nguoi dung muon tieng Anh thuan tu
# doi qua System Settings se duoc Plasma tu ghi LANG=en_US.UTF-8 +
# LANGUAGE=en_US rieng cho tai khoan ho (xem plasma-localerc).
# LC_TIME/LC_NUMERIC de theo vi_VN mac dinh (ngay/so kieu Viet); khi nguoi
# dung chon en_US trong Region & Language thi KDE tu doi format ngay/so
# sang kieu Anh cho ho. Xem docs/l10n/UPSTREAM-VI-OVERLAY-SPEC.md §4.1.
update-locale \
    LANG="${DEFAULT_LOCALE}" \
    LANGUAGE="vi_NM:vi:en_US" \
    LC_TIME="${DEFAULT_LOCALE}" \
    LC_NUMERIC="${DEFAULT_LOCALE}"

echo "namios-hook 0100: da generate locale ${LOCALES[*]}; mac dinh he thong LANG=${DEFAULT_LOCALE} LANGUAGE=vi_NM:vi:en_US; en_US van cai day du + chon duoc qua System Settings (can doi chieu tren host build that - BUILD-002)"
