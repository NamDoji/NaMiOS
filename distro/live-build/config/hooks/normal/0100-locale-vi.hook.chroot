#!/bin/bash
# NaMiOS — thiet lap locale mac dinh vi_VN.UTF-8 (VN-001). Hook nay CHAY
# TRONG CHROOT luc build anh (khong chay tren may nguoi dung, khong chay
# luc boot Live) — dung theo config/hooks/normal/ cua Debian live-build.
#
# verified_on_host: NO — chua chay qua `lb build` nao; da review theo
# Debian Live Manual muc "Live/system scripts (hooks)" [S10].
#
# AN TOAN (CLAUDE.md): khong curl|bash, khong tai noi dung tu xa, khong
# eval, chi dung cong cu da cai qua package-lists (locales/tzdata).

set -euo pipefail

LOCALE="vi_VN.UTF-8"

if [ ! -f /etc/locale.gen ]; then
    echo "namios-hook 0100: /etc/locale.gen khong ton tai - goi 'locales' chua cai, kiem tra config/package-lists/0200-locale-vi.list.chroot" >&2
    exit 1
fi

if grep -q "^# *${LOCALE} UTF-8" /etc/locale.gen; then
    sed -i "s/^# *${LOCALE} UTF-8/${LOCALE} UTF-8/" /etc/locale.gen
elif ! grep -q "^${LOCALE} UTF-8" /etc/locale.gen; then
    printf '%s UTF-8\n' "${LOCALE}" >> /etc/locale.gen
fi

locale-gen
update-locale LANG="${LOCALE}" LC_TIME="${LOCALE}" LC_NUMERIC="${LOCALE}"

echo "namios-hook 0100: da set locale mac dinh ${LOCALE} (can doi chieu lai tren host build that - BUILD-002)"
