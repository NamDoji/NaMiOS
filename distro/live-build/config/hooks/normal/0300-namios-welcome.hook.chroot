#!/bin/bash
# NaMiOS — cài module namios-welcome (UI-005, §5.2 DAC_TA_HE_DIEU_HANH.md) vào
# /opt/namios/namios_welcome trong ảnh + tạo wrapper /usr/bin/namios-welcome.
#
# Hook này chạy TRONG chroot (lb chroot_hooks), SAU khi live-build đã copy xong
# config/includes.chroot/* vào ảnh. Vì hook .hook.chroot KHÔNG có đường dẫn
# ngược ra repo host lúc build, nguồn mã Python thật phải đã được đặt sẵn tại
# /opt/namios/namios_welcome-src (đường dẫn TRONG chroot, do includes.chroot
# copy tĩnh trước đó — xem README cạnh thư mục staging đó để biết bước đồng bộ
# từ src/namios_welcome ở repo gốc). Hook này KHÔNG tự tải/lấy mã nguồn từ bất
# kỳ đâu khác — chỉ di chuyển file tĩnh đã có sẵn trong ảnh.
#
# verified_on_host: NO — hook này CHƯA được chạy qua `lb build` nào (không có
# live-build trên container phát triển hiện tại). Logic đã review bằng `bash -n`
# + đọc lại, nhưng hành vi thật của PySide6/python3 trong chroot thật CHƯA được
# xác nhận trên build host thật.
#
# AN TOAN (CLAUDE.md): set -euo pipefail; KHÔNG curl|bash; KHÔNG eval; KHÔNG
# tải/thực thi nội dung từ xa; chỉ copy file tĩnh đã có sẵn trong chroot + tạo
# một wrapper script tĩnh (không nội suy input nào vào shell).

set -euo pipefail

SRC_DIR="/opt/namios/namios_welcome-src"
DEST_PARENT="/opt/namios"
DEST_DIR="${DEST_PARENT}/namios_welcome"
WRAPPER="/usr/bin/namios-welcome"

if [ ! -d "${SRC_DIR}" ]; then
    echo "namios-hook 0300: khong thay ${SRC_DIR} - includes.chroot chua copy ma nguon namios_welcome vao anh (kiem tra config/includes.chroot/opt/namios/namios_welcome-src/)" >&2
    exit 1
fi

if [ ! -f "${SRC_DIR}/__init__.py" ] && [ ! -f "${SRC_DIR}/__main__.py" ]; then
    echo "namios-hook 0300: ${SRC_DIR} hien chi co README-PLACEHOLDER.md, CHUA co ma nguon namios_welcome that (module Python nay do mot luong viec khac viet - src/namios_welcome). Dong bo mã nguồn thật vào day truoc khi build anh phat hanh; KHONG tiep tuc build gia." >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "namios-hook 0300: khong co python3 trong anh - kiem tra config/package-lists/0110-desktop-familiar.list.chroot" >&2
    exit 1
fi

mkdir -p "${DEST_PARENT}"
rm -rf "${DEST_DIR}"
cp -a "${SRC_DIR}" "${DEST_DIR}"
rm -f "${DEST_DIR}/README-PLACEHOLDER.md"

cat > "${WRAPPER}" <<'EOF'
#!/bin/sh
# NaMiOS — wrapper chay module namios_welcome (onboarding lan dau, UI-005).
# File tinh, khong curl|bash, khong eval; chi set PYTHONPATH tinh roi exec.
set -eu
export PYTHONPATH="/opt/namios${PYTHONPATH:+:${PYTHONPATH}}"
# GUI can PySide6; neu anh phat hanh thieu goi python3-pyside6 thi bo qua
# onboarding GUI mot cach yen lang (khong lam hong phien dang nhap lan dau).
if ! python3 -c "import PySide6" >/dev/null 2>&1; then
    echo "namios-welcome: PySide6 chua san sang - bo qua onboarding GUI." >&2
    exit 0
fi
exec python3 -m namios_welcome "$@"
EOF
chmod 0755 "${WRAPPER}"

echo "namios-hook 0300: da cai namios_welcome vao ${DEST_DIR} + tao wrapper ${WRAPPER} (CAN kiem thu that tren desktop co PySide6 - verified_on_host: NO)"
