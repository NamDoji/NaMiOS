# NaMiOS — double-click kieu Windows + theme sang mac dinh cho user moi
# (UI-001/UI-004, ADR 0011).
#
# verified_on_host: NO - key/section soan theo cau truc kdeglobals da biet;
# PHAI doi chieu lai tren may co KDE Plasma/Breeze that sau khi cai goi
# package-lists/0100-desktop-kde.list.chroot (kiem tra lai neu thieu goi
# 'breeze'/'breeze-icon-theme', them vao danh sach goi do, KHONG phai file
# nay, neu thieu).
#
# SingleClick=false = bam 1 lan chi CHON, bam 2 lan (double-click) moi MO -
# day la hanh vi Windows; mac dinh Plasma thuong la single-click (SingleClick
# chua chac mac dinh true/false tuy distro, ghi ro de khong phu thuoc default).

[KDE]
SingleClick=false
widgetStyle=Breeze
# NaMiOS — tốc độ animation chuẩn KDE (mượt như iPadOS khi có GPU; VM software
# vẫn chạy, chỉ chậm theo CPU). KHÔNG đặt khoá này trong kwinrc (bug #431259).
AnimationDurationFactor=1.0

[General]
# Bộ màu NaMiOS (nhấn ĐỎ SON #C93643 — "Sen Việt" v2, 09/11/2026; THAY jade
# #168A82 của "Sen bừng sáng" v1.0, ĐÃ GỠ BỎ) file usr/share/color-schemes/NaMiOS.colors.
# verified_on_boot: NO (màu hiển thị đúng chỉ chắc khi boot KDE thật).
ColorScheme=NaMiOS
Name=NaMiOS
AccentColor=201,54,67
# Phông UI đổi sang Inter (10/11/2026, "modern desktop" wave) — gói fonts-inter
# thêm ở package-lists/0300-fonts.list.chroot; xem lý do đầy đủ + rào chắn
# "Noto vẫn là lưới an toàn" ở etc/fonts/conf.d/99-namios-rendering.conf (alias
# sans-serif cascade Be Vietnam Pro[chưa vendor] → Inter → Noto Sans theo TỪNG
# KÝ TỰ). fixed= (chữ đơn cách: terminal/mã lỗi/đường dẫn) GIỮ Noto Sans Mono,
# KHÔNG đổi (PL12.1: "Mono: Noto Sans Mono — không đổi").
# verified_on_boot: NO — glyph tiếng Việt của Inter chưa xác nhận trên máy pilot.
font=Inter,10,-1,5,50,0,0,0,0,0
fixed=Noto Sans Mono,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0

[Icons]
# Bộ icon squircle NaMiOS (kiểu iOS/iPadOS) — usr/share/icons/NaMiOS-Lotus,
# kế thừa breeze cho các icon còn lại.
Theme=NaMiOS-Lotus
