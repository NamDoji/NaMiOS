# NaMiOS — double-click kieu Windows + theme sang mac dinh cho user moi
# (UI-001/UI-004, ADR 0011).
#
# verified_on_host: NO - key/section soan theo cau truc kdeglobals da biet;
# PHAI doi chieu lai tren may co KDE Plasma/Breeze that sau khi cai goi
# package-lists/0100-desktop-kde.list.chroot (kiem tra lai neu thieu goi
# 'breeze'/'breeze-icon-theme', them vao danh sach goi do, KHONG phai file
# nay, neu thieu).
#
# SingleClick=false = bam 1 lan chi CHON, bam 2 lan (double-click) moi MO -
# day la hanh vi Windows; mac dinh Plasma thuong la single-click (SingleClick
# chua chac mac dinh true/false tuy distro, ghi ro de khong phu thuoc default).

[KDE]
SingleClick=false
widgetStyle=Breeze
# NaMiOS — mặc định LOW-END PERF (wave "desktop-theme designer senior",
# 10/11/2026): hạ AnimationDurationFactor 1.0 -> 0.6 làm mặc định cho MỌI máy
# (không chỉ VM). KHÔNG đặt khoá này trong kwinrc (bug #431259, giữ nguyên
# như trước).
#
# Lý do kỹ thuật: khi KWin compositing TAT (QEMU/TCG, may yeu — xem
# kwinrc [Compositing] Enabled=false), cac animation Plasma Quick/Kirigami
# (Kickoff mo, tooltip fade, popup notification, hover) VAN chay qua
# QT_QUICK_BACKEND=software — moi khung hinh animation la mot lan ve lai
# (QPainter raster) tren CPU, khong duoc GPU gong. Rut ngan thoi luong
# animation ~40% giam truc tiep tong thoi gian CPU phai ve lai cho MOI lan
# mo menu/tooltip/popup — loi ich thuc, khong phai suy dien.
#
# 0.6 la LUA CHON THIET KE (judgement call), KHONG phai mot nac co san trong
# slider "Toc do hoat anh" cua System Settings (chua doi chieu duoc source
# KDE thuc cho cac nac do — web_fetch/web_search khong truy cap duoc trong
# moi truong dung nay). Chon 0.6 vi: (a) van con cam giac chuyen dong muot
# ("premium"), khong giat cung nhu dat ve 0 (instant) se mat cam giac cao
# cap; (b) giam dang ke tong thoi luong ve lai so voi 1.0. May manh/GPU thuc
# nguoi dung van chinh lai duoc binh thuong qua Cai dat > Hanh vi khong gian
# lam viec > Toc do hoat anh (khoa nay KHONG bi khoa/immutable).
#
# verified_on_boot: NO — can boot KDE Plasma that (ca QEMU/TCG va may/VM co
# GPU) de xac nhan animation ngan hon co de nhan ra bang mat nhung khong giat
# cuc/khong mat cam giac "muot". Rollback: doi lai "1.0" (gia tri truoc wave
# nay) — khong anh huong gi khac, day la khoa doc lap, khong phu thuoc file
# nao khac.
AnimationDurationFactor=0.6

[General]
# Bộ màu NaMiOS (nhấn VÀNG KIM #DEA93E — "Đông Sơn" v3, 11/11/2026; THAY đỏ
# son #C93643 của "Sen Việt" v2 09/11/2026, bản thân v2 đã thay jade #168A82
# của "Sen bừng sáng" v1.0, ĐÃ GỠ BỎ) file usr/share/color-schemes/NaMiOS.colors.
# AccentColor = vai trò "signature accent" (highlight/selection/focus) theo
# AUTHORITATIVE PALETTE Đông Sơn trong usr/share/namios-branding/logo/brand.json
# + usr/share/namios/docs/BRAND.md — KHÔNG dùng vermilion #D64C3E cho accent
# toàn hệ thống (vermilion là vai trò action/attention/destructive/error).
# verified_on_boot: NO (màu hiển thị đúng chỉ chắc khi boot KDE thật).
ColorScheme=NaMiOS
Name=NaMiOS
AccentColor=222,169,62
# Phông UI đổi sang Inter (10/11/2026, "modern desktop" wave) — gói fonts-inter
# thêm ở package-lists/0300-fonts.list.chroot; xem lý do đầy đủ + rào chắn
# "Noto vẫn là lưới an toàn" ở etc/fonts/conf.d/99-namios-rendering.conf (alias
# sans-serif cascade Be Vietnam Pro[chưa vendor] → Inter → Noto Sans theo TỪNG
# KÝ TỰ). fixed= (chữ đơn cách: terminal/mã lỗi/đường dẫn) GIỮ Noto Sans Mono,
# KHÔNG đổi (PL12.1: "Mono: Noto Sans Mono — không đổi").
# verified_on_boot: NO — glyph tiếng Việt của Inter chưa xác nhận trên máy pilot.
font=Inter,10,-1,5,50,0,0,0,0,0
fixed=Noto Sans Mono,10,-1,5,50,0,0,0,0,0
menuFont=Inter,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0
toolBarFont=Inter,10,-1,5,50,0,0,0,0,0

[Icons]
# Bộ icon squircle NaMiOS (kiểu iOS/iPadOS) — usr/share/icons/NaMiOS-Lotus,
# kế thừa breeze cho các icon còn lại.
Theme=NaMiOS-Lotus
