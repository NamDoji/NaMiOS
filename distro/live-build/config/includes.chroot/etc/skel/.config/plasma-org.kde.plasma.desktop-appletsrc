# NaMiOS — 1 panel duoi man hinh (taskbar) kieu Windows: nut mo ung dung ben
# trai + task manager + system tray + dong ho (UI-001, ADR 0011).
#
# verified_on_host: NO - day la file Plasma Shell thuong TU SINH (khong phai
# file nguoi dung thuong tu tay soan); cau truc duoi day soan lai theo cac
# ban dump config panel Plasma da biet (location=4 = BottomEdge, formfactor=2
# = Horizontal cho panel). CHUA chay qua Plasma Shell that de xac nhan dung
# cu phap/gia tri enum tren phien ban Plasma dong goi trong Debian 13 trixie
# (Spike S-UI-3, ADR 0011). Plasma Shell co the TU GHI DE/danh so lai cac ID
# containment/applet ngay lan dang nhap dau - day la HANH VI BINH THUONG cua
# Plasma, khong phai loi can sua, nhung co nghia la "co dung 100% nhu duoi
# day" chi xac nhan duoc bang mat tren desktop that.
#
# icon=start-here-namios ben duoi NAY DA CO icon that (cap nhat 11/11/2026 —
# wave "Windows desktop feel", xem usr/share/namios/docs/DESKTOP-WINDOWS-
# LIKE.md): PNG "start-here-namios" (logo hoa sen squircle NaMiOS) da duoc
# dong goi o usr/share/icons/hicolor/{16,32,48,64,128,256,512}x*/apps/ VA
# usr/share/icons/NaMiOS-Lotus/{48,64,128,256,512}x*/apps/ tu commit 6060979
# ("logo chinh thuc Sen bung sang"), va kdeglobals [Icons] Theme=NaMiOS-Lotus
# da bat theme nay lam mac dinh — tuc nut Bat dau (Kickoff) o day DA hien dung
# logo NaMiOS, khong con la fallback/placeholder nua. README-PLACEHOLDER.md
# ma dong comment cu trich dan DA BI XOA (xac nhan: khong con ton tai trong
# repo) — comment cu la THONG TIN LOI THOI, da sua lai o day cho dung thuc te.
# Du vay van giu dong fail-safe: neu mot ban build sau lam mat/doi ten icon
# nay, Plasma se roi ve icon fallback chung, khong crash.

[ActionPlugins][0]
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][1][General]
# NaMiOS — wave "Windows 11 desktop parity" (11/11/2026, xem usr/share/namios/
# docs/DESKTOP-WINDOWS-LIKE.md mục 7): CĂN GIỮA cụm Start+Task-Manager kiểu
# Windows 11 (khác Windows 10 căn trái). Thêm 2 applet "Panel Spacer co giãn"
# (org.kde.plasma.panelspacer, Configuration/General expanding=true) — applet
# ID 6 TRƯỚC Kickoff (2), applet ID 7 SAU Task Manager (3) — 2 spacer co giãn
# đẩy khay hệ thống (4) + đồng hồ (5) về sát mép phải, còn cụm Start+task icon
# trôi vào giữa panel. Đây là cách ĐÚNG-KIẾN-TRÚC để căn giữa taskbar trong
# Plasma (KDE không có khoá "center taskbar" một-chạm như Windows 11).
# CŨ: AppletOrder=2;3;4;5 (Start/task trái, kiểu Windows 10).
# MỚI: AppletOrder=6;2;3;7;4;5 (Start/task CĂN GIỮA, kiểu Windows 11).
# verified_on_host: NO — PHẢI xác nhận bằng mắt trên Plasma thật: cụm
# Start+icon task nằm giữa panel, khay hệ thống+đồng hồ sát phải. Fail-safe:
# applet panelspacer là applet LÕI Plasma (luôn có sẵn, không phải gói thêm);
# nếu Plasma renumber applet ID lần đăng nhập đầu (hành vi bình thường, xem
# comment đầu file) thì thứ tự HIỂN THỊ vẫn đúng vì Plasma đọc theo
# AppletOrder, không theo số ID tuyệt đối.
# ROLLBACK: đổi AppletOrder=6;2;3;7;4;5 về lại AppletOrder=2;3;4;5 VÀ xoá 2
# block "[Containments][1][Applets][6]"/"[7]" (+ Configuration con) ở dưới —
# panel rơi về căn trái kiểu Windows 10 như trước wave này, không mất applet
# nào khác.
AppletOrder=6;2;3;7;4;5
# Panel NỔI kiểu dock (giống mockup). verified_on_boot: NO — hiệu ứng kính mờ chỉ
# hiện khi KWin compositing BẬT (trên máy thật có GPU); dưới QEMU/TCG compositing
# tắt (hook 0400) nên panel nổi sẽ đặc, không mờ — bình thường.
floating=1

