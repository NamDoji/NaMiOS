# NaMiOS — 1 panel duoi man hinh (taskbar) kieu Windows: nut mo ung dung ben
# trai + task manager + system tray + dong ho (UI-001, ADR 0011).
#
# verified_on_host: NO - day la file Plasma Shell thuong TU SINH (khong phai
# file nguoi dung thuong tu tay soan); cau truc duoi day soan lai theo cac
# ban dump config panel Plasma da biet (location=4 = BottomEdge, formfactor=2
# = Horizontal cho panel). CHUA chay qua Plasma Shell that de xac nhan dung
# cu phap/gia tri enum tren phien ban Plasma dong goi trong Debian 13 trixie
# (Spike S-UI-3, ADR 0011). Plasma Shell co the TU GHI DE/danh so lai cac ID
# containment/applet ngay lan dang nhap dau - day la HANH VI BINH THUONG cua
# Plasma, khong phai loi can sua, nhung co nghia la "co dung 100% nhu duoi
# day" chi xac nhan duoc bang mat tren desktop that.
#
# icon=start-here-namios ben duoi la TEN icon placeholder (icon that CHUA co
# - xem usr/share/namios-branding/README-PLACEHOLDER.md); neu icon khong ton
# tai trong theme that, Plasma se roi ve icon fallback chung, khong crash.

[ActionPlugins][0]
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][1][General]
AppletOrder=2;3;4;5
# Panel NỔI kiểu dock (giống mockup). verified_on_boot: NO — hiệu ứng kính mờ chỉ
# hiện khi KWin compositing BẬT (trên máy thật có GPU); dưới QEMU/TCG compositing
# tắt (hook 0400) nên panel nổi sẽ đặc, không mờ — bình thường.
floating=1

[Containments][1][Applets][2]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][1][Applets][2][Configuration][General]
icon=start-here-namios
# Ghim sẵn bộ app Office vào lưới "Ưa thích" của menu Bắt đầu → menu hiện icon
# squircle W/X/P… giống mockup (thay vì mặc định Firefox/Dolphin/Discover).
# favoritesPortedToKAstats=false để Kickoff NẠP danh sách này lần đầu.
# verified_on_boot: NO — tên .desktop phải khớp gói đã cài; cái nào lệch Kickoff bỏ qua.
favoritesPortedToKAstats=false
favorites=applications:libreoffice-writer.desktop,applications:libreoffice-calc.desktop,applications:libreoffice-impress.desktop,applications:firefox-esr.desktop,applications:org.kde.kcalc.desktop,applications:org.kde.dolphin.desktop,applications:org.kde.gwenview.desktop

[Containments][1][Applets][3]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][1][Applets][3][Configuration][General]
# Ghim app vào thanh dock (giống mockup có sẵn icon dưới thanh tác vụ).
# Gọn + nhất quán với favorites= của Kickoff ở trên (Applets][2]): dock là
# TẬP CON của favorites (không bày thêm app nào mà Kickoff không biết), thứ
# tự Máy-này/Dolphin + Trình-duyệt trước (2 việc dùng nhiều nhất kiểu Windows
# taskbar) rồi mới 3 app Office + Máy tính — gộp ý mục 5 "gọn, nhất quán"
# (Cuong giao 10/11/2026). verified_on_boot: NO — Plasma có thể tự renumber
# containment/applet ở lần đăng nhập đầu (xem comment đầu file), không phải lỗi.
launchers=applications:org.kde.dolphin.desktop,applications:firefox-esr.desktop,applications:libreoffice-writer.desktop,applications:libreoffice-calc.desktop,applications:libreoffice-impress.desktop,applications:org.kde.kcalc.desktop

[Containments][1][Applets][4]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][1][Applets][5]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][1][Applets][5][Configuration][Appearance]
use24hFormat=2
dateFormat=regular

# Containment DESKTOP (nền) + hình nền thương hiệu NaMiOS. Panel ở trên là
# [Containments][1]; đây là nền màn hình. verified_on_boot: NO — Plasma có thể
# tự đánh số lại containment lần đăng nhập đầu; nếu không nhận, Plasma rơi về
# hình nền mặc định (không hỏng). Ảnh: usr/share/backgrounds/namios/namios-default.png
[Containments][2]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.desktopcontainment
wallpaperplugin=org.kde.image

# Widget SmartAI + "nhóm việc" KHÔNG pre-seed ở đây nữa (Plasma bỏ qua vì
# activityId sinh lúc chạy). Thay bằng autostart gọi evaluateScript lần đầu:
# usr/local/bin/namios-add-widgets.sh (thêm org.namios.smartai + org.namios.workgroups).
[Containments][2][Wallpaper][org.kde.image][General]
Image=file:///usr/share/backgrounds/namios/namios-default.png
FillMode=2
