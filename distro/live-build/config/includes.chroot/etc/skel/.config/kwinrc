# NaMiOS — bat "nhan phim Win(Meta) de mo menu ung dung" kieu nut Start cua
# Windows (UI-001, ADR 0011). File nay nam canh kglobalshortcutsrc vi ly do
# KY THUAT: KGlobalAccel (co che cua kglobalshortcutsrc) KHONG cho binding mot
# modifier don le (vd chi rieng "Meta", khong kem phim nao khac) - co che do
# chi danh cho KWin qua section [ModifierOnlyShortcuts] trong kwinrc. Day
# khong phai pham vi lan ngoai nhiem vu - la phan bat buoc de hoan thanh dung
# yeu cau "Meta mo launcher".
#
# verified_on_host: NO - dia chi D-Bus "org.kde.plasmashell /PlasmaShell
# org.kde.PlasmaShell activateLauncherMenu" soan theo tai lieu/ma nguon da
# biet cua applet Kickoff; PHAI bam thu phim Meta tren desktop KDE Plasma that
# (Debian 13 trixie) truoc khi coi la dat (Spike S-UI-3, ADR 0011) - neu
# duong dan/ten method sai phien ban, phim Meta se khong lam gi (fail-safe,
# khong crash he thong), chi can sua lai gia tri nay roi build lai.

[ModifierOnlyShortcuts]
Meta=org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu

# NaMiOS — TAT compositing KWin de chay duoc tren may KHONG co GPU (QEMU/TCG,
# VM, may cu). Tren X11 KWin compositing la OpenGL-only; duoi TCG khong co GPU
# -> compositing that bai -> man den. Tat han compositing: plasmashell van ve
# wallpaper + panel bang raster X11 thuan (QT_QUICK_BACKEND=software), KHONG can
# OpenGL. May THAT co GPU: user bat lai compositing qua Settings neu muon hieu
# ung trong suot/bong do (khong bat buoc).
#
# verified_on_host: NO — can boot KDE Plasma that (Debian 13 trixie) de xac
# nhan plasmashell hien wallpaper khi Compositing Enabled=false.

[Compositing]
Enabled=false
OpenGLIsUnsafe=true

# NaMiOS — khung cửa sổ Aurorae "NaMiOS Lotus" (nút tròn 3 màu) ĐÃ DỰNG ở
# usr/share/aurorae/themes/NaMiOSLotus.
#
# ĐÃ KÍCH HOẠT làm mặc định (wave "modern desktop + fix systray", 10/11/2026) —
# cùng lúc với bật plasmarc [Theme] name=NaMiOS-Sen (xem comment ở plasmarc).
# LỊCH SỬ RỦI RO: trước đây từng NGHI theme/decoration này góp phần làm hỏng
# phiên plasmax11 ở build dfbbf3c (kẹt màn đăng nhập dưới QEMU/TCG). Đây là
# NGHI NGỜ (suspected), chưa có bisect tách riêng Aurorae ra khỏi desktoptheme
# để xác nhận THỦ PHẠM thật là cái nào (hoặc cả hai, hoặc nguyên nhân khác hẳn
# ở build đó) — ghi lại trung thực, không tuyên bố đã "sửa xong".
# Lý do bật lại dù rủi ro: NaMiOSLotusrc chỉ là theme Aurorae SVG 9-slice
# raster thường (không phải QML/OpenGL riêng) — cùng cơ chế render với
# panel-background.svg đã boot sạch được dưới software-raster (xem
# docs/releases/boot-evidence/) — nên về lý thuyết KHÔNG có lý do kỹ thuật
# riêng để treo máy nhiều hơn các SVG theme khác đã chạy được.
#
# verified_on_boot: NO — PHẢI bấm thử lại CHÍNH XÁC kịch bản QEMU/TCG đã từng
# treo (build dfbbf3c) trước khi coi đây là "đạt". NẾU tái diễn kẹt đăng nhập:
# rollback bằng cách XOÁ hẳn section [org.kde.kdecoration2] dưới đây (hoặc
# comment lại) rồi build lại — KWin sẽ tự rơi về decoration mặc định
# (org.kde.kwin.aurorae__svg__Breeze hoặc tương đương), không crash KWin, chỉ
# mất giao diện viền cửa sổ riêng của NaMiOS.
#
# >>> HOÃN BẬT Ở BẢN BUILD NÀY (wave UI/UX 10/11/2026) <<<
# Vì RỦI RO treo đăng nhập (build dfbbf3c) CHƯA loại trừ được và KHÔNG boot-test
# được trong môi trường dựng, TẠM COMMENT section decoration dưới đây để KWin
# dùng viền mặc định Breeze (ở Plasma 6 vẫn bo góc/hiện đại) — tránh nguy cơ máy
# người dùng kẹt màn đăng nhập. Desktoptheme NaMiOS-Sen (fix systray + look) VẪN
# BẬT ở plasmarc. Khi boot-test xác nhận Aurorae không gây treo → bỏ comment 3
# dòng dưới để bật viền cửa sổ riêng NaMiOS.
#[org.kde.kdecoration2]
#library=org.kde.kwin.aurorae
#theme=__aurorae__svg__NaMiOSLotus

# NaMiOS — chia/dán cửa sổ kiểu Windows (Electric Borders). Phần lớn đã là mặc định
# KWin 6.3.6; ghi tường minh cho chắc. verified_on_boot: NO.
[Windows]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerRatio=0.25
BorderSnapZone=10
WindowSnapZone=10

# Alt+Tab lưới ảnh lớn (đã là mặc định KWin 6.3.6; pin lại).
[TabBox]
LayoutName=thumbnail_grid
ShowTabBox=true
HighlightWindows=true

# NaMiOS — hiệu ứng iPadOS: CHỈ tác dụng khi compositing BẬT (máy thật có GPU;
# namios-auto-compositing.sh bật khi không phải VM). Dưới QEMU (compositing off)
# các khoá này vô hại. Blur=kính mờ; Contrast=chữ rõ trên kính; Scale/Slide=mượt;
# Wobbly/Cube=tắt (bỏ hiệu ứng kiểu cũ). verified_on_boot: NO.
[Plugins]
blurEnabled=true
contrastEnabled=true
scaleEnabled=true
slideEnabled=true
slidingpopupsEnabled=true
wobblywindowsEnabled=false
cubeslideEnabled=false
# NaMiOS — wave "macOS few-touch" (10/11/2026, UX-INTERACTION.md): bật hiệu ứng
# Overview (kiểu macOS Mission Control — xem toàn bộ cửa sổ + desktop ảo + ô
# tìm kiếm thu nhỏ cùng lúc) của KWin 6. Khoá "overviewEnabled" là khoá CHUẨN
# mà KWin effect-loader đọc cho effect có plugin id "overview" (đã đối chiếu
# nhiều bản dump kwinrc Plasma 6 thật + lệnh tham chiếu chính thức
# "kwriteconfig6 --file kwinrc --group Plugins --key overviewEnabled --type
# bool -- true/false"). Plasma 6 mặc định effect này đã BẬT sẵn và đã gán hot
# corner top-left sẵn — dòng này chỉ CHỐT RÕ tường minh, không đổi hành vi gốc.
#
# verified_on_boot: NO — PHẢI bấm thử: rê chuột lên góc trên-trái màn hình,
# đợi Overview mở ra. Revert: xoá dòng "overviewEnabled=true" (hoặc đổi thành
# false) — KWin rơi về hành vi mặc định của effect (vẫn bật sẵn trong Plasma
# 6 kể cả không có dòng này), không crash KWin.
overviewEnabled=true

# NaMiOS — macOS few-touch: GIỮ Overview CHỈ ở MỘT hot corner (góc trên-trái),
# KHÔNG gán cả 4 góc để tránh kích hoạt nhầm khi rê chuột đóng/mở cửa sổ ở các
# góc khác (yêu cầu rõ trong đặc tả wave này). Khoá "BorderActivate" là khoá
# CHUẨN KWin dùng cho mọi effect hỗ trợ screen-edge (đã thấy trong nhiều dump
# kwinrc thật + KCM "kwinscreenedges" nguồn KWin). Giá trị số theo enum
# ElectricBorder của KWin (ElectricTop=0 ... ElectricTopLeft=7 ...
# ElectricNone=9 — đối chiếu qua API doc KWin::WorkspaceWrapper + nhiều dump
# kwinrc thật dùng "9" để TẮT hẳn 1 góc). "7" = góc trên-trái (TopLeft).
#
# Cử chỉ 4-ngón-vuốt-lên trên touchpad (macOS-like) để mở Overview: KHÔNG có
# khoá kwinrc riêng để gán/đổi cử chỉ này — cử chỉ 4-ngón lên/xuống của KWin
# trên Wayland là hành vi GẮN CỨNG (hard-coded) trong chính effect, không qua
# kcm_touchpad và không đọc khoá cấu hình nào ở đây; nó tự hoạt động khi effect
# Overview đang bật (overviewEnabled=true ở trên) VÀ phiên đang chạy Wayland
# (không phải X11). KHÔNG bịa thêm khoá giả cho việc này — ghi TODO xác nhận
# bên dưới thay vì đoán sai.
#
# verified_on_boot: NO — PHẢI xác nhận TRÊN WAYLAND THẬT (không phải X11):
# (a) hot corner góc trên-trái mở Overview; (b) 4 ngón vuốt lên trên touchpad
# thật có mở Overview không, và nếu có thì hiệu ứng nào thật sự chạy (một số
# bản KWin gắn cử chỉ này cho Desktop Grid thay vì Overview — cần xem bằng mắt
# trên máy thật, không suy luận từ tài liệu). Revert: xoá cả section
# [Effect-overview] này — KWin rơi về mặc định build-in (vẫn có hot corner
# top-left theo mặc định Plasma 6), không mất chức năng, chỉ mất phần "chốt
# tường minh + giới hạn 1 góc" của NaMiOS.
[Effect-overview]
BorderActivate=7
