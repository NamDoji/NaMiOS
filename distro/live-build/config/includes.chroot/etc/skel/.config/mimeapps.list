# NaMiOS — ung dung mac dinh mo DOCX/XLSX/PPTX/PDF cho user moi (UI-003/VN,
# DATA-001, ADR 0011). Theo APP-OFF-006 (xem
# package-lists/0400-office-browser.list.chroot): tang UI hien thi ten
# LibreOffice PHAI ghi ro la "phan mem thay the" - khong lien quan file nay
# (file nay chi quyet dinh app nao MO, khong quyet dinh app xung ten gi tren
# UI hien thi cua namios-app-center/khac).
#
# verified_on_host: NO - desktop-file-id duoi day phai doi chieu lai dung ten
# that ma goi Debian 13 trixie cai ra (libreoffice/libreoffice-l10n-vi theo
# package-lists/0400-office-browser.list.chroot; okular theo
# package-lists/0100-desktop-kde.list.chroot) truoc khi coi la dat - neu sai
# ten, `xdg-mime query default <mime>` se khong tra ve gia tri nay va he
# thong roi ve app dau tien theo alphabet, phai kiem tra lai bang tay.

[Default Applications]
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop
application/vnd.openxmlformats-officedocument.presentationml.presentation=libreoffice-impress.desktop
application/msword=libreoffice-writer.desktop
application/vnd.ms-excel=libreoffice-calc.desktop
application/vnd.ms-powerpoint=libreoffice-impress.desktop
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop
application/vnd.oasis.opendocument.presentation=libreoffice-impress.desktop
application/pdf=org.kde.okular.desktop

[Added Associations]
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=libreoffice-impress.desktop;
application/msword=libreoffice-writer.desktop;
application/vnd.ms-excel=libreoffice-calc.desktop;
application/vnd.ms-powerpoint=libreoffice-impress.desktop;
application/pdf=org.kde.okular.desktop;
