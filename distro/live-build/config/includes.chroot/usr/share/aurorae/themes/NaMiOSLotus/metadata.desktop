[Desktop Entry]
Type=Service
Name=NaMiOS Lotus
Name[vi]=NaMiOS Lotus
Comment=Viền cửa sổ "Sen bừng sáng" của NaMiOS — titlebar sáng nền #f4f5f7, bo góc trên, 3 nút tròn san hô/vàng/ngọc kiểu macOS
Comment[vi]=Viền cửa sổ "Sen bừng sáng" của NaMiOS — titlebar sáng nền #f4f5f7, bo góc trên, 3 nút tròn san hô/vàng/ngọc kiểu macOS
X-KDE-PluginInfo-Name=NaMiOSLotus
X-KDE-PluginInfo-Author=NaMiOS
