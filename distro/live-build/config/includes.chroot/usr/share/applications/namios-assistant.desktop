[Desktop Entry]
Type=Application
Name=nAssistant
Name[vi]=Trợ lý
GenericName=AI chat assistant for error messages and screenshots
GenericName[vi]=Trợ lý chat AI đọc lỗi/ảnh chụp màn hình
Comment=Paste an error message or a screenshot; get step-by-step fixes classified by subsystem (boot/network/office/wine/display/print/ime/update/...), from an offline knowledge base or an optional online AI model — read-only, never changes your system
Comment[vi]=Dán thông báo lỗi hoặc ảnh chụp màn hình; nhận hướng dẫn xử lý từng bước, phân loại theo mảng hệ thống (khởi động/mạng/văn phòng/wine/màn hình/in/gõ tiếng Việt/cập nhật/...), từ kho tri thức ngoại tuyến hoặc mô hình AI trực tuyến (tuỳ chọn) — chỉ đọc/giải thích, không tự thay đổi gì trên máy
Exec=/usr/bin/namios-assistant
Icon=namios
Terminal=false
Categories=System;Utility;
Keywords=assistant;chatbot;ai;error;screenshot;ocr;troubleshoot;help;ask;
Keywords[vi]=trợ lý;chatbot;ai;lỗi;ảnh chụp màn hình;ocr;sửa lỗi;hỏi đáp;hỗ trợ;
