[Desktop Entry]
Type=Application
Name=nSettings
Name[vi]=Cài đặt
GenericName=Settings hub
GenericName[vi]=Nơi tập trung cài đặt
Comment=One familiar place for Accounts, Display, Network, Devices, Personalization, Time & Language, Apps and Update — grouped the Windows-familiar way
Comment[vi]=Một chỗ quen thuộc cho Tài khoản, Màn hình & Hiển thị, Mạng, Thiết bị, Cá nhân hoá, Ngôn ngữ & Thời gian, Ứng dụng và Cập nhật — nhóm theo kiểu người dùng Windows đã quen
Exec=/usr/local/bin/namios-control-panel
Icon=preferences-system
Terminal=false
Categories=System;Settings;
Keywords=control panel;settings;accounts;account;display;network;devices;personalization;theme;time;language;apps;update;
Keywords[vi]=bảng điều khiển;cài đặt;tài khoản;màn hình;hiển thị;mạng;thiết bị;cá nhân hoá;giao diện;ngôn ngữ;thời gian;ứng dụng;cập nhật;
