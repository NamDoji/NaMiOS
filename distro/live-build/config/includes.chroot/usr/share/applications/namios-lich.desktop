[Desktop Entry]
Type=Application
Name=nCalendar
Name[vi]=Lịch
GenericName=Vietnamese lunar calendar
GenericName[vi]=Lịch âm Việt Nam
Comment=Today's lunar date + Can-Chi + a month grid with solar/lunar side by side + Vietnamese holidays, offline, with recurring lunar death-anniversary reminders
Comment[vi]=Ngày âm lịch hôm nay + Can-Chi + lưới tháng dương/âm song song + ngày lễ Việt Nam, hoàn toàn ngoại tuyến, có nhắc giỗ lặp hằng năm theo âm lịch
Exec=/usr/bin/namios-lich
Icon=namios-calendar
Terminal=false
Categories=Utility;Office;Calendar;
Keywords=calendar;lunar;am lich;can chi;holiday;tet;
Keywords[vi]=lịch;âm lịch;can chi;ngày lễ;tết;giỗ;nhắc giỗ;
