[Desktop Entry]
Type=Application
Name=nAI
Name[vi]=Hỏi AI
GenericName=Guided assistant for common issues
GenericName[vi]=Hướng dẫn xử lý sự cố từng bước (khác với Trợ lý chat AI)
Comment=Rule-based Vietnamese helper for network/print/IME/update/Windows-app issues; read-only by default, asks permission before any change, names the rollback
Comment[vi]=Trình hướng dẫn tiếng Việt xử lý sự cố mạng/in/gõ tiếng Việt/cập nhật/app Windows theo từng bước có sẵn (không phải chat với AI); mặc định chỉ đọc, hỏi quyền trước mọi thay đổi, luôn nêu cách hoàn tác
Exec=/usr/local/bin/namios-smartai
Icon=namios
Terminal=false
Categories=System;Utility;
Keywords=smartai;assistant;help;network;print;ime;update;rollback;wine;troubleshoot;
Keywords[vi]=smartai;trợ lý;hỗ trợ;mạng;in;gõ tiếng việt;cập nhật;hoàn tác;wine;sửa lỗi;mất mạng;không in được;
NoDisplay=true
