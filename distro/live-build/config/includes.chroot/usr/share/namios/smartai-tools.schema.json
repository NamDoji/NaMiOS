{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "namios.smartai-tools/v1",
  "schema": "namios.smartai-tools/v1",
  "version": "1.0.0",
  "status": "specified",
  "generated": "2026-11-09",
  "milestone": "PL14 AI-0",
  "source_of_truth": "docs/specs/SMARTAI-TOOL-BROKER.md",
  "maps_to": [
    "docs/spec-package/NaMiOS_Phu_luc_14_SmartAI_Core_Nguoi_Viet.md (§3.1 hợp đồng công cụ mẫu, §4 ma trận quyền)",
    "src/namios_smartai/tools.py (ToolRegistry/ToolSpec — engine PL04, mock)",
    "distro/.../usr/local/bin/namios-smartai (+ policy.sh — cổng confirm_and_run thật)",
    "distro/.../usr/share/namios/error-catalog.json (safe_actions.kind/privileged/undo/playbook)"
  ],
  "notes_vi": "Catalog TYPED-TOOL máy-đọc cho SmartAI Broker (PL14 §3.1). Gồm: (1) JSON Schema 'tool_contract' cho MỘT lời gọi tool do lớp lập kế hoạch phát ra; (2) 'tool_catalog' = allow-list typed tool device-doctor do đội NaMiOS KÝ. BẤT BIẾN: model KHÔNG tự tạo target/preconditions/consent rồi tự xác nhận; Broker đối chiếu trạng thái THẬT + catalog đã ký. TRẠNG THÁI 'specified': chưa có Broker chạy đối chiếu trạng thái thật; chữ ký ở đây là placeholder (khoá lab, chưa production key).",
  "autonomy_levels": {
    "L0": "Giải thích — chỉ nguồn/sự kiện có quyền, không gọi tool thay đổi.",
    "L1": "Đọc chẩn đoán — read-only trong phạm vi phiên/chính sách, hiện AI đang kiểm gì.",
    "L2": "Thao tác đảo ngược — snapshot/diff + xác nhận + giới hạn thử + kiểm + hoàn tác khi sai.",
    "L3": "Thay đổi đáng kể — người dùng/IT duyệt hành động cụ thể; nguồn gói xác thực; backup/đường quay lại.",
    "L4": "Giao dịch/khó đảo ngược — AI chỉ chuẩn bị + hướng dẫn; người có quyền tự xác nhận trong UI chính thức."
  },
  "consent_kinds": {
    "none": "Không cần consent (read-only L0/L1).",
    "explicit_user_confirmation": "Người dùng bấm xác nhận cho hành động + phạm vi cụ thể (L2/L3).",
    "authority_approval": "Người/đơn vị có quyền (IT/admin) duyệt hành động cụ thể (L3).",
    "transaction": "Xác nhận GIAO DỊCH có nội dung + người nhận trong UI chính thức; 'cứ làm đi' KHÔNG thay thế (L4)."
  },
  "evidence_kinds": {
    "read-only": "Chỉ đọc — không đổi gì.",
    "state-change": "Có thay đổi — BẮT BUỘC qua cổng chính sách + consent.",
    "launch": "Mở GUI cho người dùng tự thao tác (SmartAI không bấm thay).",
    "manual": "Người dùng tự làm ngoài phần mềm."
  },

  "$defs": {
    "autonomy_level": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "consent_kind": { "enum": ["none", "explicit_user_confirmation", "authority_approval", "transaction"] },
    "rollback_class": { "enum": ["none", "reversible", "snapshot", "irreversible"] },
    "opaque_id": {
      "type": "string",
      "description": "ID mờ do Broker/OS cấp (không phải tên thật/đường dẫn). Model KHÔNG được tự tạo.",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },

    "tool_contract": {
      "type": "object",
      "description": "Hợp đồng MỘT lời gọi tool (PL14 §3.1). Lớp lập kế hoạch phát ra; Broker xác minh TRƯỚC khi chạy. Các trường preconditions/consent/target do Broker đối chiếu trạng thái thật + catalog, KHÔNG do model tự điền-rồi-tự-duyệt.",
      "additionalProperties": false,
      "required": [
        "schema_version", "tool", "target", "task_id",
        "preconditions", "scope", "consent", "timeout_seconds",
        "idempotency_key", "expected_evidence", "rollback", "data_sent_to_model"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "tool": {
          "type": "string",
          "description": "Tên tool; PHẢI có trong tool_catalog đã ký (fail-closed nếu lạ)."
        },
        "target": {
          "type": "object",
          "description": "Mục tiêu bằng id mờ do Broker cấp (vd printer_id). KHÔNG đường dẫn/tên thật do model sinh.",
          "minProperties": 0,
          "additionalProperties": { "$ref": "#/$defs/opaque_id" }
        },
        "task_id": {
          "$ref": "#/$defs/opaque_id",
          "description": "Nối lời gọi vào một Task của Context/Task Manager (truy vết, Tiếp-tục-sau-reboot)."
        },
        "preconditions": {
          "type": "array",
          "description": "Điều kiện Broker PHẢI quan sát ĐÚNG trên trạng thái thật trước khi chạy. Thiếu/không khớp → BLOCKED.",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "string",
          "description": "Phạm vi hẹp nhất đủ dùng (vd one_printer_one_page). Broker từ chối vượt scope."
        },
        "consent": { "$ref": "#/$defs/consent_kind" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "idempotency_key": {
          "$ref": "#/$defs/opaque_id",
          "description": "Khoá chống lặp cho tool có side-effect. Trùng khoá → Broker trả kết quả cũ, KHÔNG chạy lại."
        },
        "expected_evidence": {
          "type": "array",
          "description": "Bằng chứng kỳ vọng để Outcome Validator kiểm (vd job_id, printer_job_state). KHÔNG dùng text model làm bằng chứng.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "rollback": {
          "type": "string",
          "description": "Cách hoàn tác cụ thể, hoặc nói rõ 'không đảo ngược được' (vd cancel_if_queued / timeshift_restore / none_irreversible)."
        },
        "data_sent_to_model": {
          "type": "array",
          "description": "Khai báo TƯỜNG MINH dữ liệu gửi model (minh bạch §1.1-6). Mặc định rỗng = không gửi. KHÔNG gửi nội dung tài liệu/khoá ký/mật khẩu/bản in.",
          "items": { "type": "string" }
        }
      }
    },

    "tool_catalog_entry": {
      "type": "object",
      "description": "Khai báo MỘT typed tool trong allow-list đã ký. Broker chỉ cho chạy tool có ở đây; model KHÔNG nạp thêm tool.",
      "additionalProperties": false,
      "required": [
        "tool", "autonomy_level", "evidence_kind", "consent_default",
        "privileged", "writes", "rollback_class", "required_params",
        "preconditions_checked", "expected_evidence", "maps_playbook", "data_to_model_default", "detector"
      ],
      "properties": {
        "tool": { "type": "string" },
        "summary_vi": { "type": "string" },
        "autonomy_level": { "$ref": "#/$defs/autonomy_level" },
        "evidence_kind": { "enum": ["read-only", "state-change", "launch", "manual"] },
        "consent_default": { "$ref": "#/$defs/consent_kind" },
        "privileged": {
          "type": "boolean",
          "description": "true ⇒ phải qua pkexec/polkit (hệ thống hỏi mật khẩu). Không có đường vòng."
        },
        "writes": { "type": "boolean" },
        "rollback_class": { "$ref": "#/$defs/rollback_class" },
        "required_params": { "type": "array", "items": { "type": "string" } },
        "scope": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "preconditions_checked": {
          "type": "array",
          "description": "Precondition Broker đối chiếu trạng thái THẬT (adapter) — model không tự tạo.",
          "items": { "type": "string" }
        },
        "expected_evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "maps_playbook": {
          "type": "string",
          "description": "Playbook tương ứng trong namios-smartai (hoặc delegate_*) — nối hợp đồng về mã thật."
        },
        "data_to_model_default": { "type": "array", "items": { "type": "string" } },
        "detector": {
          "type": "string",
          "description": "'có' = adapter đọc trạng thái thật đã tồn tại; 'specified' = chưa nối, mới là hợp đồng."
        }
      }
    }
  },

  "tool_catalog_signature": {
