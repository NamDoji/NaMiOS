[Plymouth Theme]
Name=NaMiOS
Description=NaMiOS - splash khoi dong don gian: nen nga am gradient + logo sen do son (v2 "Sen Viet") + thanh tien trinh do son (module two-step co san trong goi plymouth-themes, khong phai QML/script tu viet -> it rui ro man den tren may khong GPU)
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/namios

# An toan man den: ke ca khi background.png thieu/hong, plugin two-step tu ve
# gradient bang 2 ma mau nay (xem plugin.c view_set_pixel_buffer_background ->
# ply_pixel_buffer_fill_with_gradient khi background_image == NULL). Dat
# ScaleBackgroundImage=true de anh gradient luon duoc keo vua man hinh that
# (tranh lap/noi seam neu do phan giai QEMU khac 1920x1080).
ScaleBackgroundImage=true
# Ngà ấm (sen quý không đặt nền đen — QĐ Cuong 09/11/2026), đồng bộ wallpaper.
BackgroundStartColor=0xfbf8f2
BackgroundEndColor=0xefe3d1

# Logo ngang (hoa sen + chu "NaMiOS") canh giua man hinh, ti le ~44% chieu cao
# (dong bo voi vi tri logo tren wallpaper desktop namios-default.png).
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.44

# Thanh tien trinh mau do son (v2) tren nen nga am nhat hon mot chut, canh
# giua ngang, gan day man hinh. Rong co dinh 480px = dung bang watermark.png
# (xep cot). Da doi tu jade #168a82 (bo nhan dien "Sen bung sang" cu, DA GO
# BO) sang do son #c93643 (bo nhan dien v2 "Sen Viet").
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.84
ProgressBarWidth=480
ProgressBarHeight=6
ProgressBarBackgroundColor=0xe3d6c2
ProgressBarForegroundColor=0xc93643

Transition=none
TransitionDuration=0

[boot-up]
# Hien thanh tien trinh that (boot progress tu plymouth --update), KHONG dung
# throbber xoay (UseAnimation mac dinh tu dong = !UseProgressBar = false khi
# dong nay = true -> khong can khai bao rieng, ghi ro de minh bach).
UseProgressBar=true
UseAnimation=false
UseFirmwareBackground=false

# KHONG khai bao [shutdown]/[reboot]: mac dinh (UseProgressBar=false,
# UseAnimation=true nhung khong co file throbber-*.png) -> chi hien nen+logo
# tinh, khong ve gi them. Don gian + an toan, dung muc tieu "dien hinh".
#
# POLISH 10/11/2026 (wave "boot-identity", thong nhat 3 diem cham-tram boot
# GRUB/isolinux/Plymouth): watermark.png duoc sinh lai co them 1 quang sang
# vang_tam (#F2C66D) mo, lam mo (Gaussian blur) chi quanh bong hoa sen — khop
# voi quang sang moi them vao splash.png cua GRUB va isolinux (xem ghi chu
# trong config/bootloaders/grub-pc/live-theme/theme.txt). Canvas watermark.png
# lon hon truoc (805x489 thay vi 480x173) de co cho quang sang mo-dan KHONG
# bi cat net o mep anh (tranh loi "hinh chu nhat" khi alpha-composite mot lop
# blur qua gan canvas) — NOI DUNG logo (hoa sen+chu) giu NGUYEN kich thuoc
# tuong doi (~480px rong nhu truoc), chi them vien trong suot quanh. Da kiem
# tra cong thuc WatermarkVerticalAlignment=.44 voi kich thuoc canvas moi: vi
# he so (0.5-0.44)=0.06 nho, tam logo tren man hinh chi lech ~19px tren man
# 1080px (<2%) — khong can doi lai .44. verified_on_host: NO (chi kiem bang
# composite thu qua Pillow, chua boot that).
