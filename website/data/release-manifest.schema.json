{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://namios.vn/schema/release-manifest.schema.json",
  "title": "NaMiOS release manifest",
  "description": "Nguồn sự thật duy nhất cho trạng thái phát hành NaMiOS. Trang /download, CTA trang chủ và structured data SoftwareApplication đều phải đọc từ file khớp schema này. Theo docs/specs/namios-pl17-website/03_DOWNLOAD_TUONG_THICH.md §3.",
  "type": "object",
  "required": ["schema_version", "product", "channel", "version", "status", "downloads", "last_updated"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "product": { "type": "string", "const": "NaMiOS" },
    "channel": { "type": "string", "enum": ["beta", "stable"] },
    "version": { "type": "string", "minLength": 1 },
    "release_date": { "type": ["string", "null"], "format": "date" },
    "status": {
      "type": "string",
      "enum": ["pre_release", "beta", "stable"],
      "description": "pre_release = chưa có ISO phát hành được phê duyệt, trang tải KHÔNG được có nút tải, chỉ CTA nhận thông báo/xem tiến độ."
    },
    "architectures": {
      "type": "array",
      "items": { "type": "string", "enum": ["x86_64", "arm64"] },
      "description": "Chỉ liệt kê kiến trúc đã có bản build thật; pre_release phải để trống."
    },
    "minimum_hardware": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "ram_gb": { "type": "number" },
        "disk_gb": { "type": "number" },
        "uefi_required": { "type": "boolean" },
        "secure_boot": { "type": "string", "enum": ["required", "supported", "unsupported", "not_tested"] },
        "gpu_note": { "type": "string" },
        "evidence_url": { "type": ["string", "null"] }
      }
    },
    "downloads": {
      "type": "array",
      "description": "pre_release BẮT BUỘC là mảng rỗng — không có file ISO nào được công bố.",
      "items": {
        "type": "object",
        "required": ["architecture", "url", "size_bytes", "sha256", "signature_url", "mirror_of"],
        "additionalProperties": false,
        "properties": {
          "architecture": { "type": "string", "enum": ["x86_64", "arm64"] },
          "filename": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signature_url": { "type": "string", "format": "uri" },
          "mirror_of": { "type": ["string", "null"] }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_key_url": { "type": ["string", "null"] },
        "fingerprint": { "type": ["string", "null"] },
        "key_catalog_url": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text_vi", "state"],
        "properties": {
          "claim_id": { "type": "string" },
          "text_vi": { "type": "string" },
          "state": {
            "type": "string",
            "enum": ["released", "verified_specific", "trial", "in_development"],
            "description": "released=Đã có trên bản phát hành; verified_specific=Đã thử nghiệm trên thiết bị/phiên bản cụ thể; trial=Bản thử nghiệm; in_development=Đang phát triển."
          },
          "evidence_url": { "type": ["string", "null"] },
          "last_verified": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text_vi", "severity"],
        "properties": {
          "id": { "type": "string" },
          "text_vi": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "workaround_vi": { "type": ["string", "null"] }
        }
      }
    },
    "support_url": { "type": ["string", "null"] },
    "progress_url": { "type": ["string", "null"] },
    "notify": {
      "type": "object",
      "description": "Chính sách form 'Nhận thông báo'. mode=demo nghĩa là KHÔNG có dịch vụ gửi email thật phía sau — không thu thập/lưu địa chỉ email.",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["demo", "live"] },
        "endpoint": { "type": ["string", "null"] },
        "double_opt_in": { "type": "boolean" },
        "note_vi": { "type": "string" }
      }
    },
    "last_updated": { "type": "string", "format": "date" },
    "manifest_owner": { "type": "string" },
    "note_vi": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pre_release" } } },
      "then": {
        "properties": {
          "downloads": { "maxItems": 0 },
          "architectures": { "maxItems": 0 },
          "release_date": { "const": null }
        }
      }
    }
  ]
}
